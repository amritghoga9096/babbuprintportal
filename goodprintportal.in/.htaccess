RewriteEngine On

# Step 1: Try rewriting to .php if no extension and not a real file/dir
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-zA-Z0-9/_-]+)$ $1.php [NC]

# Step 2: If under /members/ and file still not found → go to /members/404.php
RewriteCond %{REQUEST_URI} ^/members/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^.*$ /404.php [L]

# Step 3: All other missing files → redirect to index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^.*$ /index.php [L]


# Security for specific file types
<Files 403.shtml>
    Order allow,deny
    Allow from all
</Files>

<FilesMatch ".*\.(zip|json)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

