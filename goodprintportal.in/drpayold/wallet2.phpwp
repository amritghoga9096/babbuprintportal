                            }
                            while ($row = mysqli_fetch_assoc($res)) {
                                $_s = strtolower(trim((string)$row['status']));
                                if ($_s === 'success') {
                                    $_badgeCls = 'badge-wallet-success';
                                    $_badgeTxt = 'Success';
                                } elseif ($_s === 'rejected' || $_s === 'failed' || $_s === 'fail' || $_s === 'error') {
                                    $_badgeCls = 'badge-wallet-danger';
                                    $_badgeTxt = ($_s === 'rejected') ? 'Rejected' : 'Failed';
                                } elseif ($_s === 'pending') {
                                    $_badgeCls = 'badge-wallet-pending';
                                    $_badgeTxt = 'Pending';
                                } else {
                                    $_badgeCls = 'badge-wallet-pending';
                                    $_badgeTxt = htmlspecialchars($row['status']);
                                }
                                echo "<tr>
                                    <td>{$i}</td>
                                    <td>".htmlspecialchars($row['phone'])."</td>
                                    <td>".htmlspecialchars($row['BANKTXNID'])."</td>
                                    <td><strong style='color:#111827;'>₹".htmlspecialchars($row['amount'])."</strong></td>
                                    <td>".htmlspecialchars($row['RESPMSG'])."</td>
                                    <td>".htmlspecialchars($row['PAYMENTMODE'])."</td>
                                    <td><span class='{$_badgeCls}'>{$_badgeTxt}</span></td>
                                    <td>".htmlspecialchars($row['txn_date'])."</td>
                                </tr>";
                                $i++;
                            }
