<script>
function checkOrderStatus(order_id) {
    const statusDiv = document.getElementById("txnStatus");
    let checkCount = 0;
    const maxChecks = 120; // 10 minutes (120 * 5 seconds)
    
    const intervalId = setInterval(async () => {
        try {
            checkCount++;
            statusDiv.innerText = `Checking payment status... (${Math.floor(checkCount * 5 / 60)} min)`;
            
            const formData = new FormData();
            formData.append('check_order_status', '1');
            formData.append('order_id', order_id);
            
            const response = await fetch('', {
                method: 'POST',
                body: formData
            });
            
            const data = await response.json();
            
            if (data.status === 'success') {
                clearInterval(intervalId);
                Swal.close();
                Swal.fire({
                    icon: 'success',
                    title: 'Payment Successful,
                    html: `<b>Amount:</b> ${data.data.amount}<br><b>UTR:</b> ${data.data.utr}<br><b>Date:</b> ${data.data.date}`,
                    confirmButtonColor: '#4e54c8'
                }).then(() => { 
                    window.location.href = 'wallet.php'; 
                });
            } else if (data.status === 'error') {
                clearInterval(intervalId);
                statusDiv.innerText = data.message;
            }
            
            if (checkCount >= maxChecks) {
                clearInterval(intervalId);
                statusDiv.innerText = "Payment check timeout. Please contact support if payment was made.";
            }
        } catch (error) {
            console.error('Error checking payment status:', error);
            statusDiv.innerText = "Error checking status. Retrying...";
        }
    }, 5000);
}
</script>

