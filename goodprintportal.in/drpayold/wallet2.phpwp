/* --- Font + base polish inside page content --- */
.page-content {
    font-family: 'Inter','Nunito', system-ui, sans-serif;
}

/* ============================================================
   1. WALLET HERO / TRUST BANNER (top section)
   ============================================================ */
.wallet-hero {
    position: relative;
    overflow: hidden;
    border-radius: 22px;
    padding: 26px 28px 24px 28px;
    margin-bottom: 28px;
    color: #fff;
    background:
        radial-gradient(800px 250px at 100% 0%, rgba(255,255,255,0.20) 0%, transparent 55%),
        radial-gradient(400px 200px at 0% 100%, rgba(255,255,255,0.14) 0%, transparent 55%),
        linear-gradient(135deg, #0f172a 0%, #1e3a8a 35%, #6366f1 65%, #8b5cf6 85%, #ec4899 100%);
    box-shadow:
        0 20px 50px -20px rgba(99,102,241,0.65),
        0 10px 25px -10px rgba(139,92,246,0.45),
        inset 0 1px 0 rgba(255,255,255,0.25);
    border: 1px solid rgba(255,255,255,0.18);
}
/* animated shimmer sweep */
.wallet-hero::before {
    content:"";
    position:absolute; inset:0;
    background: linear-gradient(115deg,
        transparent 0%, transparent 35%,
        rgba(255,255,255,0.16) 50%,
        transparent 65%, transparent 100%);
    background-size: 200% 100%;
    animation: walletShine 5.5s linear infinite;
    pointer-events:none;
}
@keyframes walletShine {
    0%   { background-position: 200% 0; }
    100% { background-position: -100% 0; }
}
/* decorative blobs */
.wallet-hero::after {
    content:"";
    position:absolute;
    width:260px; height:260px;
    right:-80px; top:-90px;
    border-radius:50%;
    background: radial-gradient(circle, rgba(255,255,255,0.14), transparent 70%);
    pointer-events:none;
}
.wallet-hero > * { position:relative; z-index:2; }

.wallet-hero-title {
    display:flex; align-items:center; gap:12px;
    font-size: 22px; font-weight: 800; margin-bottom: 6px;
    letter-spacing: 0.2px;
    font-family: 'Nunito', sans-serif;
}
.wallet-hero-title .wh-icon {
    width:44px; height:44px; border-radius:12px;
    display:inline-flex; align-items:center; justify-content:center;
    background: rgba(255,255,255,0.18);
    border: 1px solid rgba(255,255,255,0.35);
    backdrop-filter: blur(6px);
    box-shadow: 0 4px 14px rgba(0,0,0,0.15);
    font-size: 20px;
}
.wallet-hero-sub {
    font-size: 13.5px;
    opacity: 0.94;
    line-height: 1.55;
    max-width: 640px;
    margin-bottom: 14px;
}

/* --- Trust Pills row --- */
.trust-pills {
    display:flex; flex-wrap:wrap; gap:10px;
}
.trust-pill {
    display:inline-flex; align-items:center; gap:7px;
    padding: 7px 13px;
    border-radius: 999px;
    font-size: 12.5px;
    font-weight: 700;
    background: rgba(255,255,255,0.14);
    border: 1px solid rgba(255,255,255,0.3);
    backdrop-filter: blur(6px);
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.25);
    letter-spacing: 0.2px;
}
.trust-pill i { font-size: 14px; }
.tp-green i  { color: #86efac; }
.tp-blue  i  { color: #93c5fd; }
.tp-gold  i  { color: #fde68a; }
.tp-pink  i  { color: #f9a8d4; }

/* ============================================================
   2. ADD MONEY FORM CARD (Premium)
   ============================================================ */
.wallet-card {
    position: relative;
    border-radius: 22px;
    background:
        radial-gradient(circle at 100% 0%, rgba(139,92,246,0.06) 0%, transparent 45%),
        radial-gradient(circle at 0% 100%, rgba(236,72,153,0.06) 0%, transparent 45%),
        #ffffff;
    padding: 26px 28px;
    border: 1px solid rgba(139,92,246,0.12);
    box-shadow:
        0 14px 40px -20px rgba(99,102,241,0.35),
        0 4px 10px rgba(0,0,0,0.04);
    margin-bottom: 26px;
    overflow:hidden;
}
/* Gradient border frame */
.wallet-card::before {
    content:""; position:absolute; inset:0; border-radius:22px; padding:1.5px;
    background: linear-gradient(135deg,
        rgba(99,102,241,0.45),
        rgba(139,92,246,0.25),
        rgba(236,72,153,0.4),
        rgba(245,158,11,0.5));
    -webkit-mask:
        linear-gradient(#fff 0 0) content-box,
        linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
            mask-composite: exclude;
    pointer-events:none;
    z-index: 1;
}
.wallet-card > * { position:relative; z-index:2; }

.wallet-card-head {
    display:flex; align-items:center; justify-content:space-between;
    flex-wrap:wrap; gap:10px; margin-bottom: 18px;
}
.wallet-card-title {
    font-family: 'Nunito', sans-serif;
    font-size: 18px; font-weight: 800; color: #0f172a;
    display:flex; align-items:center; gap:10px;
}
.wallet-card-title .wc-dot {
    width:34px; height:34px; border-radius:10px;
    display:inline-flex; align-items:center; justify-content:center;
    background: linear-gradient(135deg, #6366f1, #8b5cf6);
    color:#fff; font-size:16px;
    box-shadow: 0 4px 12px rgba(139,92,246,0.4);
}

/* --- Input group (override inline styles) --- */
.wallet-card .input-group {
    position: relative;
    display:block;
    margin-bottom: 18px;
}
.wallet-card .input-group label {
    display:block;
    margin-bottom: 8px;
    font-weight: 700;
    font-size: 13.5px;
    color: #1e293b;
    letter-spacing: 0.2px;
}
.wallet-card .input-group input {
    width:100%;
    padding: 14px 46px 14px 16px;
    border: 1.5px solid rgba(139,92,246,0.22);
    border-radius: 13px;
    font-size: 17px;
    font-weight: 600;
    color: #0f172a;
    transition: all 0.3s ease;
    background:
        radial-gradient(circle at 100% 0%, rgba(139,92,246,0.05), transparent 50%),
        #fafbff;
    box-shadow: inset 0 1px 2px rgba(15,23,42,0.04);
}
.wallet-card .input-group input::placeholder {
    color: #94a3b8;
    font-weight: 500;
    font-size: 14px;
}
.wallet-card .input-group input:focus {
    outline:none;
    border-color: #8b5cf6;
    background: #fff;
    box-shadow:
        0 0 0 4px rgba(139,92,246,0.12),
        0 4px 12px rgba(139,92,246,0.12);
    transform: translateY(-1px);
}
.wallet-card .input-group .input-icon {
    position: absolute;
    right: 16px;
    top: 50%;
    transform: translateY(-8%);
    width: 32px; height: 32px; border-radius: 9px;
    display: inline-flex; align-items:center; justify-content:center;
    background: linear-gradient(135deg, rgba(99,102,241,0.12), rgba(236,72,153,0.12));
    color: #7c3aed;
    font-size: 15px;
    font-weight: 800;
    border: 1px solid rgba(139,92,246,0.18);
}

/* --- Quick amount buttons --- */
.wallet-card .quick-btn {
    display:inline-flex; align-items:center; gap:6px;
    padding: 8px 14px;
    margin: 0 6px 8px 0;
    border-radius: 11px;
    font-size: 13px; font-weight: 700;
    color: #4f46e5;
    background: linear-gradient(135deg, rgba(99,102,241,0.08), rgba(236,72,153,0.08));
    border: 1.5px solid rgba(139,92,246,0.22);
    cursor:pointer;
    transition: all 0.25s ease;
    text-decoration:none !important;
}
.wallet-card .quick-btn:hover {
    color: #fff;
    background: linear-gradient(135deg, #6366f1, #8b5cf6);
    border-color: transparent;
    transform: translateY(-2px);
    box-shadow: 0 6px 14px rgba(139,92,246,0.4);
}

/* --- Info line (Min/Max) --- */
.wallet-minmax {
    font-size: 13px;
    color: #64748b;
    margin-bottom: 18px;
    padding: 10px 14px;
    border-radius: 11px;
    background: linear-gradient(135deg, #f0f9ff, #eef2ff);
    border: 1px solid rgba(99,102,241,0.12);
    display:flex; align-items:center; gap:8px;
    font-weight: 600;
}
.wallet-minmax i { color:#6366f1; }

/* --- Proceed to Pay button --- */
.wallet-pay-btn {
    position: relative;
    overflow: hidden;
    width:100%;
    padding: 15px 20px;
    border: none;
    border-radius: 14px;
    font-size: 16px;
    font-weight: 800;
    color: #fff;
    letter-spacing: 0.3px;
    display:flex; align-items:center; justify-content:center; gap:10px;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(.2,.8,.2,1);
    background:
        radial-gradient(600px 100px at 100% 0%, rgba(255,255,255,0.28) 0%, transparent 55%),
        linear-gradient(135deg, #10b981 0%, #0ea5e9 35%, #6366f1 70%, #8b5cf6 100%);
    background-size: 200% 200%;
    box-shadow:
        0 14px 32px -10px rgba(16,185,129,0.45),
        0 10px 24px -10px rgba(99,102,241,0.5),
        inset 0 1px 0 rgba(255,255,255,0.35);
    text-shadow: 0 1px 3px rgba(0,0,0,0.18);
}
.wallet-pay-btn i { font-size: 17px; }
.wallet-pay-btn::before {
    content:"";
    position:absolute; inset:0;
    background: linear-gradient(115deg,
        transparent 0%, transparent 35%,
        rgba(255,255,255,0.22) 50%,
        transparent 65%, transparent 100%);
    background-size: 200% 100%;
    animation: walletShine 3.2s linear infinite;
    pointer-events:none;
}
.wallet-pay-btn:hover {
    transform: translateY(-3px) scale(1.01);
    background-position: 100% 100%;
    box-shadow:
        0 20px 40px -12px rgba(16,185,129,0.5),
        0 14px 28px -10px rgba(139,92,246,0.55),
        inset 0 1px 0 rgba(255,255,255,0.45);
}
.wallet-pay-btn:active { transform: translateY(-1px) scale(0.995); }

/* --- old btn-custom compatibility (safety) --- */
.btn-custom {
    position: relative; overflow:hidden;
    background: linear-gradient(135deg, #10b981, #0ea5e9, #6366f1, #8b5cf6);
    background-size: 200% 200%;
    color:#fff; border:none;
    padding: 15px 20px; width:100%;
    border-radius: 14px; font-size:16px; font-weight:800;
    cursor:pointer; transition: all 0.3s ease;
    display:flex; justify-content:center; align-items:center; gap:10px;
    box-shadow:
        0 14px 32px -10px rgba(16,185,129,0.45),
        0 10px 24px -10px rgba(99,102,241,0.5),
        inset 0 1px 0 rgba(255,255,255,0.35);
}
.btn-custom:hover {
    transform: translateY(-3px);
    background-position: 100% 100%;
    box-shadow: 0 20px 40px -12px rgba(16,185,129,0.5), 0 14px 28px -10px rgba(139,92,246,0.55);
    filter: none;
    color:#fff;
    background-color: transparent !important;
}

/* ============================================================
   3. TRUST STRIP — Payment Methods / Logos / Seals
   ============================================================ */
.trust-strip {
    border-radius: 18px;
    padding: 18px 20px;
    margin-bottom: 28px;
    background:
        radial-gradient(circle at 100% 0%, rgba(16,185,129,0.08), transparent 45%),
        #ffffff;
    border: 1px solid rgba(16,185,129,0.15);
    box-shadow: 0 6px 18px -8px rgba(16,185,129,0.25);
}
.trust-strip-title {
    font-size: 13px; font-weight: 800;
    color: #166534;
    display:flex; align-items:center; gap:8px;
    margin-bottom: 14px;
    letter-spacing: 0.4px;
    text-transform: uppercase;
}
.trust-strip-title i {
    width:26px; height:26px; border-radius:8px;
    display:inline-flex; align-items:center; justify-content:center;
    background: linear-gradient(135deg, #10b981, #059669);
    color:#fff; font-size: 13px;
    box-shadow: 0 3px 8px rgba(16,185,129,0.4);
}
.trust-logos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));
    gap: 12px;
}
.trust-logo {
    display:flex; align-items:center; justify-content:center;
    flex-direction:column; gap:4px;
    padding: 12px 10px;
    border-radius: 12px;
    background: linear-gradient(135deg, #f8fafc, #ffffff);
    border: 1px solid rgba(148,163,184,0.22);
    transition: all 0.25s ease;
}
.trust-logo:hover {
    border-color: rgba(99,102,241,0.35);
    transform: translateY(-2px);
    box-shadow: 0 8px 18px -10px rgba(99,102,241,0.4);
}
.trust-logo .tl-icon {
    width:36px; height:36px; border-radius:10px;
    display:inline-flex; align-items:center; justify-content:center;
    font-size: 18px; color:#fff;
    margin-bottom: 2px;
}
.tl-upi    { background: linear-gradient(135deg, #0f766e, #10b981); box-shadow: 0 4px 10px rgba(16,185,129,0.45); }
.tl-gpay   { background: linear-gradient(135deg, #4285f4, #34a853, #fbbc05, #ea4335); background-size: 240% 240%; box-shadow:0 4px 10px rgba(66,133,244,0.45); }
.tl-phonepe{ background: linear-gradient(135deg, #5b21b6, #7c3aed); box-shadow: 0 4px 10px rgba(124,58,237,0.45); }
.tl-paytm  { background: linear-gradient(135deg, #1d4ed8, #0ea5e9); box-shadow: 0 4px 10px rgba(29,78,216,0.45); }
.tl-bhim   { background: linear-gradient(135deg, #15803d, #facc15); box-shadow: 0 4px 10px rgba(21,128,61,0.45); }
.tl-netb   { background: linear-gradient(135deg, #1e293b, #475569); box-shadow: 0 4px 10px rgba(51,65,85,0.45); }
.tl-card   { background: linear-gradient(135deg, #ea580c, #f59e0b); box-shadow: 0 4px 10px rgba(234,88,12,0.45); }
.tl-ssl    { background: linear-gradient(135deg, #082f49, #0369a1); box-shadow: 0 4px 10px rgba(3,105,161,0.45); }

.trust-logo .tl-name {
    font-size: 11.5px;
    font-weight: 800;
    color: #334155;
    letter-spacing: 0.2px;
}
.trust-logo .tl-sub {
    font-size: 10px;
    color: #64748b;
    font-weight: 600;
}

/* ============================================================
   4. SECURITY FEATURES 3-COL CARDS
   ============================================================ */
.security-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 16px;
    margin-bottom: 28px;
}
.security-card {
    position: relative;
    border-radius: 16px;
    padding: 18px 18px 16px 18px;
    border: 1px solid rgba(139,92,246,0.14);
    background: #fff;
    transition: all 0.3s ease;
    overflow:hidden;
}
.security-card:hover {
    transform: translateY(-4px);
    box-shadow:
        0 16px 32px -16px rgba(139,92,246,0.45),
        0 4px 10px rgba(0,0,0,0.05);
    border-color: rgba(139,92,246,0.3);
}
.security-card::before {
    content:""; position:absolute; inset:0; border-radius:16px; padding:1.5px;
    background: linear-gradient(135deg,
        rgba(99,102,241,0.5), rgba(236,72,153,0.3), rgba(245,158,11,0.5));
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor; mask-composite: exclude;
    pointer-events:none; opacity:0;
    transition: opacity 0.3s ease;
}
.security-card:hover::before { opacity: 1; }
.sc-icon {
    width:46px; height:46px; border-radius:13px;
    display:inline-flex; align-items:center; justify-content:center;
    font-size:20px; color:#fff; margin-bottom:10px;
}
.sc-blue   { background: linear-gradient(135deg, #2563eb, #7c3aed); box-shadow:0 6px 14px rgba(124,58,237,0.45); }
.sc-green  { background: linear-gradient(135deg, #059669, #10b981); box-shadow:0 6px 14px rgba(16,185,129,0.45); }
.sc-gold   { background: linear-gradient(135deg, #d97706, #f59e0b); box-shadow:0 6px 14px rgba(245,158,11,0.45); }
.sc-pink   { background: linear-gradient(135deg, #be123c, #ec4899); box-shadow:0 6px 14px rgba(236,72,153,0.45); }

.sc-title {
    font-family: 'Nunito', sans-serif;
    font-size: 14.5px; font-weight: 800; color:#0f172a; margin-bottom:4px;
}
.sc-text {
    font-size: 12.5px; color:#64748b; font-weight:500; line-height:1.55;
}

/* ============================================================
   5. PAYMENT HISTORY TABLE
   ============================================================ */
.wallet-table-card {
    position: relative;
    border-radius: 20px;
    padding: 0;
    overflow:hidden;
    border: 1px solid rgba(139,92,246,0.12);
    box-shadow:
        0 14px 40px -20px rgba(99,102,241,0.3),
        0 4px 10px rgba(0,0,0,0.04);
    background:#fff;
}
.wallet-table-card::before {
    content:""; position:absolute; inset:0; border-radius:20px; padding:1.5px;
    background: linear-gradient(135deg, rgba(99,102,241,0.4), rgba(236,72,153,0.3));
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor; mask-composite: exclude;
    pointer-events:none; z-index:1;
}
.wallet-table-card > * { position:relative; z-index:2; }
.wallet-table-head {
    padding: 16px 22px;
    background:
        radial-gradient(600px 120px at 100% 0%, rgba(255,255,255,0.22) 0%, transparent 55%),
        linear-gradient(135deg, #6366f1 0%, #8b5cf6 45%, #ec4899 100%);
    color:#fff;
    font-family: 'Nunito', sans-serif;
    font-size: 16px; font-weight: 800;
    display:flex; align-items:center; gap:10px;
    letter-spacing: 0.2px;
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.3);
}
.wallet-table-head i {
    width:32px; height:32px; border-radius:10px;
    display:inline-flex; align-items:center; justify-content:center;
    background: rgba(255,255,255,0.18);
    border: 1px solid rgba(255,255,255,0.3);
    font-size: 15px;
}
.wallet-table-card .table {
    margin: 0;
}
.wallet-table-card thead.thead-premium {
    background: linear-gradient(135deg, #f1f5f9, #eef2ff);
}
.wallet-table-card thead.thead-premium th {
    font-family: 'Nunito', sans-serif;
    font-size: 12.5px; font-weight: 800;
    color: #4338ca;
    letter-spacing: 0.4px;
    text-transform: uppercase;
    padding: 12px 16px;
    border-bottom: 1.5px solid rgba(139,92,246,0.2);
}
.wallet-table-card tbody td {
    font-size: 13px;
    padding: 11px 16px;
    border-bottom: 1px solid #f1f5f9;
    font-weight: 500;
    color: #334155;
}
.wallet-table-card tbody tr:hover td {
    background: linear-gradient(90deg, rgba(99,102,241,0.04), rgba(236,72,153,0.04));
}
.badge-wallet-success {
    background: linear-gradient(135deg, #059669, #10b981) !important;
    color: #fff !important;
    padding: 4px 10px !important;
    border-radius: 999px !important;
    font-size: 11px !important;
    font-weight: 800 !important;
    box-shadow: 0 3px 8px rgba(16,185,129,0.35);
    border: 1px solid rgba(255,255,255,0.4) !important;
}
.badge-wallet-danger {
    background: linear-gradient(135deg, #dc2626, #ef4444) !important;
    color: #fff !important;
    padding: 4px 10px !important;
    border-radius: 999px !important;
    font-size: 11px !important;
    font-weight: 800 !important;
    box-shadow: 0 3px 8px rgba(239,68,68,0.35);
    border: 1px solid rgba(255,255,255,0.4) !important;
}
.badge-wallet-pending {
    background: linear-gradient(135deg, #d97706, #f59e0b) !important;
    color: #fff !important;
    padding: 4px 10px !important;
    border-radius: 999px !important;
    font-size: 11px !important;
    font-weight: 800 !important;
    box-shadow: 0 3px 8px rgba(245,158,11,0.35);
    border: 1px solid rgba(255,255,255,0.4) !important;
}

/* ============================================================
   6. HOW-TO POPUP / MODAL (replace old look)
   ============================================================ */
.wallet-modal-overlay {
    display: none;
    position: fixed; z-index: 999999;
    inset: 0;
    background: radial-gradient(circle at 50% 0%, rgba(99,102,241,0.2), rgba(15,23,42,0.7));
    backdrop-filter: blur(3px);
}
.wallet-modal {
    background: #fff;
    width: 92%;
    max-width: 560px;
    margin: 4% auto;
    border-radius: 20px;
    position: relative;
    max-height: 88vh;
    overflow-y: auto;
    box-shadow:
        0 30px 60px -20px rgba(99,102,241,0.5),
        0 15px 30px -10px rgba(0,0,0,0.3);
    overflow: hidden;
    animation: wmIn .35s cubic-bezier(.2,.9,.3,1.2) both;
}
@keyframes wmIn { from { transform: translateY(30px) scale(.95); opacity:0; } to { transform:none; opacity:1; } }
.wallet-modal-head {
    padding: 20px 24px 18px 24px;
    color:#fff;
    background:
        radial-gradient(600px 120px at 100% 0%, rgba(255,255,255,0.25) 0%, transparent 55%),
        linear-gradient(135deg, #6366f1, #8b5cf6, #ec4899);
    display:flex; align-items:center; justify-content:space-between;
    gap:10px;
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.3);
}
.wallet-modal-head h5 {
    font-family: 'Nunito', sans-serif;
    font-size: 18px; font-weight: 800; margin:0;
    display:flex; align-items:center; gap:10px;
    letter-spacing: 0.2px;
}
.wallet-modal-head i.wmh-icon {
    width:34px; height:34px; border-radius:10px;
    display:inline-flex; align-items:center; justify-content:center;
    background: rgba(255,255,255,0.18);
    border: 1px solid rgba(255,255,255,0.3);
    font-size: 16px;
}
.wallet-modal-close {
    width:34px; height:34px; border-radius:10px;
    display:inline-flex; align-items:center; justify-content:center;
    background: rgba(255,255,255,0.18);
    border: 1px solid rgba(255,255,255,0.3);
    color:#fff; font-size:18px; cursor:pointer;
    transition: all 0.2s ease;
}
.wallet-modal-close:hover {
    background: rgba(255,255,255,0.3);
    transform: rotate(90deg);
}
.wallet-modal-body { padding: 22px 24px; }

.wm-box {
    border-radius: 14px;
    padding: 16px 18px;
    margin-bottom: 16px;
    border: 1px solid rgba(139,92,246,0.14);
    background: linear-gradient(135deg, #ffffff, #fafafa);
    position: relative;
}
.wm-box-info { background: linear-gradient(135deg, #eff6ff, #eef2ff); border-color: rgba(99,102,241,0.22); }
.wm-box-sec  { background: linear-gradient(135deg, #ecfdf5, #f0fdfa); border-color: rgba(16,185,129,0.25); }
.wm-box-lim  { background: linear-gradient(135deg, #fffbeb, #fef3c7); border-color: rgba(245,158,11,0.28); }

.wm-box-title {
    font-family: 'Nunito', sans-serif;
    font-size: 15px; font-weight: 800; margin-bottom: 10px;
    display:flex; align-items:center; gap:8px;
}
.wm-box-info .wm-box-title { color: #3730a3; }
.wm-box-sec  .wm-box-title { color: #047857; }
.wm-box-lim  .wm-box-title { color: #92400e; }

.wm-box-title i {
    width:28px; height:28px; border-radius:8px;
    display:inline-flex; align-items:center; justify-content:center;
    color:#fff; font-size:13px;
}
.wm-box-info .wm-box-title i { background: linear-gradient(135deg, #6366f1, #8b5cf6); }
.wm-box-sec  .wm-box-title i { background: linear-gradient(135deg, #10b981, #059669); }
.wm-box-lim  .wm-box-title i { background: linear-gradient(135deg, #f59e0b, #d97706); }

.wm-list { list-style:none; padding:0; margin:0; }
.wm-list li {
    padding: 6px 0;
    font-weight: 600;
    font-size: 13px;
    display:flex; align-items:center; gap:8px;
    color: #334155;
}
.wm-list li i { color: #10b981; font-size: 13px; }
.wm-box-sec .wm-list li i { color: #059669; }
.wm-box-info .wm-list li i { color: #6366f1; }
.wm-box-lim .wm-list li i { color: #d97706; }

/* Open "How to Add Money" button premium */
.wallet-help-btn {
    padding: 11px 18px;
    border: none;
    border-radius: 13px;
    background: linear-gradient(135deg, #8b5cf6, #ec4899);
    color: #fff;
    font-weight: 800; font-size: 13px;
    letter-spacing: 0.2px;
    cursor: pointer;
    transition: all 0.25s ease;
    display:inline-flex; align-items:center; gap:8px;
    box-shadow: 0 6px 14px rgba(139,92,246,0.45);
    margin-bottom: 20px;
}
.wallet-help-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 22px rgba(236,72,153,0.5);
}
.wallet-help-btn i { font-size: 15px; }

/* Old open-btn fallback */
.open-btn {
    padding: 11px 18px !important;
    border-radius: 13px !important;
    background: linear-gradient(135deg, #8b5cf6, #ec4899) !important;
    color:#fff !important; font-weight:800 !important;
    font-size:13px !important;
    box-shadow: 0 6px 14px rgba(139,92,246,0.45) !important;
    border:none !important;
    cursor:pointer;
}
.open-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 22px rgba(236,72,153,0.5) !important;
}

/* ============================================================
   7. Responsive
   ============================================================ */
@media (max-width: 768px) {
    .wallet-hero { padding: 20px 18px; border-radius: 18px; }
    .wallet-hero-title { font-size: 18px; }
    .wallet-card, .trust-strip, .wallet-table-card { border-radius: 16px; }
    .wallet-card { padding: 20px 18px; }
    .wallet-pay-btn { padding: 13px; font-size: 15px; }
    .security-grid { gap: 12px; }
    .trust-logos { grid-template-columns: repeat(2, 1fr); }
}
/* ============================================================
   V3 — SCREENSHOT JAISA EXACT CLEAN UI
   Hero → Add Balance dark green card
   → Step 1 Enter Amount
   → Attractive input (min badge inside RIGHT)
   → 6 Quick cards (3x2 + Popular ribbon)
   → Mega green Proceed
   → 4 trust circles
   → SSL + PCI footer
   ============================================================ */

/* -------- 1. ADD BALANCE HERO CARD (COMPACT — no scroll) -------- */
.ab-hero{
    position:relative;
    background:linear-gradient(135deg,#022c22 0%,#064e3b 45%,#065f46 75%,#047857 100%);
    border-radius:16px;
    padding:16px 20px;
    margin-bottom:14px;
    overflow:hidden;
    display:flex; align-items:center; justify-content:space-between; gap:14px; flex-wrap:wrap;
    box-shadow:0 8px 20px rgba(5,150,105,0.22), 0 2px 8px rgba(0,0,0,0.06);
}
.ab-hero::before{
    content:""; position:absolute; inset:-20%; right:-10%; width:320px; height:320px;
    background:radial-gradient(circle, rgba(16,185,129,0.15) 0%, transparent 65%);
    pointer-events:none;
}
.abh-left{display:flex; align-items:center; gap:14px; z-index:2;}
.abh-icon{
    position:relative;
    width:56px; height:56px; border-radius:16px;
    background:linear-gradient(135deg,#10b981 0%,#059669 60%,#047857 100%);
    display:flex; align-items:center; justify-content:center;
    color:#fff; font-size:24px;
    box-shadow:0 6px 16px rgba(16,185,129,0.38), inset 0 1px 0 rgba(255,255,255,0.25);
    border:1.5px solid rgba(52,211,153,0.4);
    flex-shrink:0;
}
.abh-plus{
    position:absolute; bottom:-3px; right:-3px;
    width:22px; height:22px; border-radius:50%;
    background:#fff; color:#059669;
    display:flex; align-items:center; justify-content:center;
    font-size:9px; font-weight:900;
    box-shadow:0 2px 5px rgba(0,0,0,0.15);
    border:1.5px solid #065f46;
}
.abh-title-wrap{display:flex; flex-direction:column; gap:3px;}
.abh-title{
    margin:0;
    font-size:26px; font-weight:900; line-height:1.05;
    color:#fff;
    letter-spacing:-0.3px;
}
.abh-title-accent{
    background:linear-gradient(135deg,#86efac 0%,#34d399 50%,#22d3ee 100%);
    -webkit-background-clip:text; background-clip:text; color:transparent;
}
.abh-sub{
    margin:0;
    font-size:12.5px;
    color:#a7f3d0;
    max-width:420px;
    line-height:1.35;
    font-weight:500;
    opacity:0.95;
}
.abh-right{position:relative; z-index:2;}
.abh-coins{position:relative; width:120px; height:80px;}
.abh-coin{
    position:absolute;
    display:flex; align-items:center; justify-content:center;
    background:linear-gradient(135deg,#fde68a 0%,#f59e0b 50%,#d97706 100%);
    color:#78350f;
    border-radius:50%;
    font-weight:900;
    border:2.5px solid #fbbf24;
    box-shadow:0 4px 10px rgba(217,119,6,0.5);
}
.ac1{width:42px; height:42px; top:12px; right:22px; font-size:14px; z-index:2; transform:rotate(-12deg);}
.ac2{width:38px; height:38px; top:34px; right:0; font-size:13px; z-index:1; opacity:0.92; transform:rotate(8deg);}
.abh-sparkle{position:absolute; color:#fde68a; font-size:11px; opacity:0.9;}
.sp1{top:2px; right:50px; animation:twinkle 1.8s ease-in-out infinite;}
.sp2{top:22px; right:6px; color:#a7f3d0; animation:twinkle 2.2s ease-in-out infinite 0.3s;}
.sp3{top:62px; right:62px; color:#fff; font-size:8px; animation:twinkle 2s ease-in-out infinite 0.6s;}
@keyframes twinkle{0%,100%{opacity:0.3; transform:scale(0.7);} 50%{opacity:1; transform:scale(1.15);}}

/* -------- 2. STEP HEAD (COMPACT numbered) -------- */
.wallet-card-top{margin-top:0; padding-top:18px;}
.step-head{
    display:flex; align-items:center; gap:12px;
    margin-bottom:14px;
}
.step-num{
    width:38px; height:38px; border-radius:50%;
    background:linear-gradient(135deg,#10b981 0%,#059669 100%);
    display:flex; align-items:center; justify-content:center;
    box-shadow:0 4px 10px rgba(16,185,129,0.32);
    flex-shrink:0;
}
.sn-inner{
    width:27px; height:27px; border-radius:50%;
    background:radial-gradient(circle at 30% 30%, #86efac, #10b981);
    display:flex; align-items:center; justify-content:center;
    color:#fff;
    font-size:15px; font-weight:900;
    box-shadow:inset 0 1px 0 rgba(255,255,255,0.35);
}
.step-text-wrap{display:flex; flex-direction:column; gap:2px;}
.step-title{font-size:18px; font-weight:900; color:#0f172a; letter-spacing:-0.2px;}
.step-sub{font-size:12px; color:#64748b; font-weight:500;}

/* -------- 3. ATTRACTIVE AMOUNT INPUT (COMPACT — no scroll) */
.ai-wrap{
    position:relative;
    display:flex; align-items:stretch;
    background:linear-gradient(135deg,#022c22,#064e3b);
    border-radius:14px;
    padding:4px;
    box-shadow:0 6px 18px rgba(5,150,105,0.18), inset 0 1px 0 rgba(255,255,255,0.06);
    margin-bottom:20px;
    transition:all 0.3s ease;
}
.ai-wrap::before{
    content:""; position:absolute; inset:0; padding:2px; border-radius:14px;
    background:linear-gradient(135deg,#34d399 0%,#10b981 50%,#0ea5e9 100%);
    -webkit-mask:linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor; mask-composite: exclude;
    pointer-events:none;
    opacity:0.9;
}
.ai-wrap:focus-within{
    transform:translateY(-1.5px);
    box-shadow:0 10px 26px rgba(16,185,129,0.28), 0 0 0 3px rgba(16,185,129,0.12);
}
.ai-wrap:focus-within::before{opacity:1;}
.ai-left{
    display:flex; align-items:center; justify-content:center;
    padding:0 12px 0 14px;
    border-right:1.5px solid rgba(52,211,153,0.25);
    min-width:44px;
}
.ai-rupee{
    font-size:26px; font-weight:900;
    background:linear-gradient(135deg,#86efac 0%,#34d399 55%,#22d3ee 100%);
    -webkit-background-clip:text; background-clip:text; color:transparent;
    line-height:1;
}
.ai-mid{flex:1; min-width:0; display:flex; align-items:center;}
.ai-input{
    width:100%;
    border:none; outline:none; background:transparent !important;
    padding:14px 14px;
    font-size:24px; font-weight:800; color:#ecfdf5;
    letter-spacing:-0.3px;
    min-height:44px;
}
.ai-input::placeholder{color:rgba(167,243,208,0.5); font-weight:600; font-size:20px;}
.ai-right{
    display:flex; align-items:center;
    padding:0 14px 0 8px;
    border-left:1.5px solid rgba(52,211,153,0.2);
}
.ai-minbadge{
    display:inline-flex; align-items:center;
    font-size:11px; font-weight:800; color:#a7f3d0;
    background:rgba(16,185,129,0.14);
    border:1.5px solid rgba(52,211,153,0.35);
    padding:5px 11px;
    border-radius:999px;
    white-space:nowrap;
}
.winput-error{
    position:absolute; left:0; right:0; bottom:-30px;
    z-index:5;
}
.winput-error.we-err{
    background:linear-gradient(135deg,#fef2f2,#fee2e2);
    color:#991b1b; border:1.5px solid #fecaca;
    animation:shake 0.35s ease;
    padding:9px 14px;
    border-radius:10px;
    font-size:13px; font-weight:700;
    display:flex; align-items:center; gap:8px;
}
@media (max-width: 575px){
    .winput-error{
        position: absolute !important;
        left: 0 !important;
        right: 0 !important;
        bottom: -68px !important;    /* niche dhakel diya — Quick amounts head pe overlap karega, card input pe NAHI */
        width: 100% !important;
        z-index: 10 !important;
    }
    .winput-error.we-err{
        font-size: 12.5px;
        padding: 10px 13px;
        box-shadow: 0 6px 18px rgba(153, 27, 27, .18);
    }
}
@keyframes shake{
    0%,100%{transform:translateX(0);}
    25%{transform:translateX(-5px);}
    75%{transform:translateX(5px);}
}

/* -------- 4. QUICK AMOUNTS HEAD (COMPACT) */
.qa-head{
    display:flex; align-items:center; gap:10px;
    margin-bottom:10px;
}
.qa-bolt{
    width:32px; height:32px; border-radius:10px;
    background:linear-gradient(135deg,#fef3c7 0%,#fde68a 100%);
    display:flex; align-items:center; justify-content:center;
    color:#d97706;
    font-size:14px;
    border:1.5px solid #fcd34d;
    flex-shrink:0;
}
.qa-title{font-size:15px; font-weight:900; color:#0f172a;}
.qa-sub{font-size:11.5px; color:#64748b; margin-top:1px;}

/* -------- 5. 6 QUICK AMOUNT CARDS 3x2 grid COMPACT (no extra height) */
.qa-grid{
    display:grid;
    grid-template-columns:repeat(3, 1fr);
    gap:10px;
    margin-bottom:18px;
}
.qa-card{
    position:relative;
    border:none; cursor:pointer;
    padding:14px 8px 12px 8px;
    background:linear-gradient(135deg,#022c22 0%,#064e3b 100%);
    color:#ecfdf5;
    border-radius:13px;
    transition:all 0.22s ease;
    box-shadow:0 3px 10px rgba(0,0,0,0.05);
    display:flex; flex-direction:column; align-items:center; justify-content:center; gap:2px;
}
.qa-card::before{
    content:""; position:absolute; inset:0; border-radius:13px; padding:2px;
    background:linear-gradient(135deg,rgba(52,211,153,0.35), rgba(16,185,129,0.2), rgba(14,165,233,0.3));
    -webkit-mask:linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor; mask-composite: exclude;
    pointer-events:none;
    opacity:0.6;
    transition:opacity 0.22s ease;
}
.qa-card:hover{
    transform:translateY(-2px) scale(1.02);
    background:linear-gradient(135deg,#064e3b 0%,#065f46 100%);
    box-shadow:0 8px 18px rgba(16,185,129,0.22);
}
.qa-card:hover::before{opacity:1;}
.qa-amt{font-size:20px; font-weight:900; letter-spacing:-0.2px; line-height:1.1;}
.qa-label{
    font-size:11px; font-weight:600;
    color:#86efac;
    letter-spacing:0.1px;
    opacity:0.95;
}
.qa-popular{
    background:linear-gradient(135deg,#065f46 0%,#047857 60%,#059669 100%);
    box-shadow:0 5px 16px rgba(16,185,129,0.26);
}
.qa-popular::before{
    background:linear-gradient(135deg,#34d399,#10b981 50%,#22d3ee);
    opacity:1;
}
.qa-popular-ribbon{
    position:absolute;
    top:-8px; right:50%; transform:translateX(50%);
    display:inline-flex; align-items:center; gap:4px;
    background:linear-gradient(135deg,#22c55e 0%,#16a34a 50%,#15803d 100%);
    color:#fff;
    font-size:10px; font-weight:800;
    padding:3px 11px;
    border-radius:999px;
    box-shadow:0 3px 8px rgba(22,163,74,0.35);
    border:1.5px solid #4ade80;
    white-space:nowrap;
}
.qa-popular-ribbon i{font-size:10px;}

/* -------- 6. PAY BUTTON — THINNER (no huge padding) -------- */
.mega-pay-btn{
    width:100%;
    border:none; cursor:pointer;
    padding:15px 22px;
    border-radius:14px;
    background:linear-gradient(135deg,#34d399 0%,#22c55e 40%,#16a34a 80%,#15803d 100%);
    color:#052e16;
    display:flex; align-items:center; justify-content:center;
    gap:12px;
    transition:all 0.26s cubic-bezier(.2,.8,.2,1);
    box-shadow:0 8px 22px rgba(34,197,94,0.35), 0 3px 10px rgba(0,0,0,0.06);
    position:relative; overflow:hidden;
    margin-bottom:18px;
}
.mega-pay-btn::before{
    content:""; position:absolute; inset:0;
    background:linear-gradient(120deg, transparent 22%, rgba(255,255,255,0.38) 50%, transparent 78%);
    background-size:250% 100%; background-position:220% 0;
    transition:background-position 0.7s ease;
    pointer-events:none;
}
.mega-pay-btn:hover{
    transform:translateY(-2px);
    box-shadow:0 14px 32px rgba(34,197,94,0.45), 0 4px 12px rgba(0,0,0,0.08);
}
.mega-pay-btn:hover::before{background-position:-80% 0;}
.mega-pay-btn:active{transform:translateY(-1px);}
.mpb-icon{
    width:34px; height:34px; border-radius:10px;
    background:rgba(5,46,22,0.18);
    border:1.5px solid rgba(5,46,22,0.25);
    display:flex; align-items:center; justify-content:center;
    color:#052e16; font-size:17px;
    flex-shrink:0;
}
.mpb-text{
    font-size:18px; font-weight:900;
    letter-spacing:0.2px;
    flex:1; text-align:center;
}
.mpb-arrow{
    font-size:17px; font-weight:900;
    color:#052e16;
    transition:transform 0.3s ease;
}
.mega-pay-btn:hover .mpb-arrow{transform:translateX(6px);}

/* -------- 7. 4 TRUST CIRCLES — COMPACT / MINI -------- */
.trust4-row{
    display:flex;
    align-items:center; justify-content:space-between;
    gap:8px; flex-wrap:wrap;
    margin-bottom:14px;
    padding:10px 14px;
    background:linear-gradient(135deg,#f8fafc 0%,#f1f5f9 100%);
    border-radius:13px;
    border:1.5px solid #e2e8f0;
}
.t4-item{
    display:flex; align-items:center; gap:8px;
    padding:0;
}
.t4-circle{
    width:34px; height:34px; border-radius:50%;
    display:flex; align-items:center; justify-content:center;
    color:#10b981;
    font-size:14px;
    flex-shrink:0;
    background:rgba(16,185,129,0.12);
    border:1.5px solid rgba(16,185,129,0.2);
}
.t4-shield{color:#10b981; background:rgba(16,185,129,0.12); border-color:rgba(16,185,129,0.2);}
.t4-bolt{color:#f59e0b; background:rgba(245,158,11,0.12); border-color:rgba(245,158,11,0.22);}
.t4-lock{color:#6366f1; background:rgba(99,102,241,0.12); border-color:rgba(99,102,241,0.22);}
.t4-users{color:#ec4899; background:rgba(236,72,153,0.12); border-color:rgba(236,72,153,0.22);}
.t4-text{display:flex; flex-direction:column; gap:0; line-height:1.1;}
.t4-main{font-size:11.5px; font-weight:800; color:#0f172a;}
.t4-sub{font-size:10.5px; font-weight:600; color:#64748b;}

/* -------- 8. TRUSTED FOOTER CARD (SSL + PCI DSS) — COMPACT -------- */
.trustfoot-card{
    display:flex; align-items:center; justify-content:space-between; gap:14px; flex-wrap:wrap;
    background:linear-gradient(135deg,#f0fdf4 0%,#ecfdf5 50%,#ecfeff 100%);
    border-radius:13px;
    padding:12px 16px;
    border:1.5px solid rgba(134,239,172,0.5);
}
.tf-left{display:flex; align-items:center; gap:10px; flex:1; min-width:200px;}
.tf-badge{
    width:36px; height:36px; border-radius:10px;
    background:linear-gradient(135deg,#10b981 0%,#059669 100%);
    color:#fff;
    display:flex; align-items:center; justify-content:center;
    font-size:16px;
    box-shadow:0 4px 10px rgba(16,185,129,0.3);
    flex-shrink:0;
}
.tf-title{font-size:13.5px; font-weight:900; color:#064e3b; line-height:1.1;}
.tf-sub{font-size:11px; color:#047857; margin-top:2px; font-weight:500; line-height:1.2;}
.tf-right{display:flex; align-items:center; gap:8px; flex-wrap:wrap;}
.tf-chip{
    display:flex; align-items:center; gap:8px;
    padding:7px 12px;
    background:#fff;
    border-radius:10px;
    border:2px solid #bbf7d0;
    box-shadow:0 2px 6px rgba(0,0,0,0.04);
}
.tf-chip > i{
    font-size:16px; color:#6366f1;
    padding:6px 7px; border-radius:7px;
    background:linear-gradient(135deg,#eef2ff,#e0e7ff);
}
.tf-chip:nth-child(2) > i{color:#10b981; background:linear-gradient(135deg,#ecfdf5,#d1fae5);}
.tfc-top{font-size:12px; font-weight:900; color:#0f172a; line-height:1;}
.tfc-bot{font-size:9.5px; font-weight:700; color:#64748b; margin-top:2px;}

/* -------- 9. RESPONSIVE — ALL IN VIEWPORT NO SCROLL -------- */
@media (max-width: 960px){
    .qa-grid{grid-template-columns:repeat(3, 1fr);}
}
@media (max-width: 768px){
    .ab-hero{padding:14px 18px; gap:10px; border-radius:14px;}
    .abh-icon{width:48px; height:48px; font-size:20px; border-radius:14px;}
    .abh-plus{width:20px; height:20px; font-size:8px;}
    .abh-title{font-size:22px;}
    .abh-sub{font-size:11.5px;}
    .abh-coins{width:100px; height:60px;}
    .ac1{width:36px; height:36px; top:8px; right:16px; font-size:12px;}
    .ac2{width:32px; height:32px; top:24px; right:0; font-size:11px;}
    .abh-sparkle{display:none;}
    .ai-input{font-size:22px; padding:12px 12px; min-height:40px;}
    .ai-rupee{font-size:24px;}
    .ai-minbadge{font-size:10px; padding:4px 9px;}
    .mpb-text{font-size:16px;}
    .mega-pay-btn{padding:13px 18px; border-radius:13px; gap:10px;}
    .qa-grid{grid-template-columns:repeat(3, 1fr); gap:8px;}
    .qa-card{padding:12px 6px 10px 6px; border-radius:11px;}
    .qa-amt{font-size:17px;}
    .qa-label{font-size:10px;}
    .qa-popular-ribbon{font-size:9px; padding:2px 9px;}
    .t4-main{font-size:10.5px;}
    .t4-sub{font-size:9.5px;}
    .t4-circle{width:30px; height:30px; font-size:12px;}
    .trust4-row{padding:8px 10px; gap:6px;}
    .trustfoot-card{padding:10px 12px;}
    .tf-badge{width:32px; height:32px; border-radius:9px; font-size:14px;}
    .tf-chip{padding:5px 10px;}
}
@media (max-width: 560px){
    .ab-hero{padding:12px 14px; margin-bottom:10px; border-radius:14px;}
    .abh-left{gap:10px;}
    .abh-icon{width:42px; height:42px; font-size:18px; border-radius:12px;}
    .abh-title{font-size:20px;}
    .abh-sub{font-size:11px;}
    .abh-right{display:none;}
    .wallet-card-top{padding-top:14px;}
    .step-head{gap:10px; margin-bottom:10px;}
    .step-num{width:32px; height:32px;}
    .sn-inner{width:22px; height:22px; font-size:13px;}
    .step-title{font-size:15px;}
    .step-sub{font-size:11px;}
    .ai-wrap{padding:3px; border-radius:12px; margin-bottom:14px;}
    .ai-left{padding:0 10px; min-width:36px;}
    .ai-rupee{font-size:20px;}
    .ai-input{font-size:18px; padding:10px 8px; min-height:36px;}
    .ai-input::placeholder{font-size:16px;}
    .ai-right{padding:0 10px 0 6px;}
    .ai-minbadge{padding:4px 8px; font-size:9.5px;}
    .qa-head{margin-bottom:8px;}
    .qa-bolt{width:28px; height:28px; border-radius:8px; font-size:12px;}
    .qa-title{font-size:13px;}
    .qa-sub{font-size:10.5px;}
    .qa-grid{grid-template-columns:repeat(3, 1fr); gap:6px; margin-bottom:14px;}
    .qa-card{padding:10px 4px 8px 4px; border-radius:10px;}
    .qa-amt{font-size:15px;}
    .qa-label{font-size:9px;}
    .qa-popular-ribbon{font-size:8.5px; padding:2px 7px; top:-6px;}
    .mpb-icon{width:30px; height:30px; border-radius:9px; font-size:15px;}
    .mpb-text{font-size:15px;}
    .mpb-arrow{font-size:15px;}
    .mega-pay-btn{padding:12px 14px; border-radius:12px; gap:8px; margin-bottom:14px;}
    .trust4-row{
        display:grid;
        grid-template-columns:repeat(2, 1fr);
        gap:6px; padding:8px 10px;
    }
    .t4-circle{width:28px; height:28px; font-size:11px;}
    .t4-text{align-items:flex-start;}
    .t4-item{justify-content:flex-start;}
    .tf-left{min-width:100%;}
    .tf-right{width:100%; justify-content:center;}
    .tf-chip{padding:5px 9px;}
    .tf-badge{width:30px; height:30px; border-radius:8px; font-size:13px;}
    .tf-title{font-size:12.5px;}
    .tf-sub{font-size:10.5px;}
    .tfc-top{font-size:11px;}
    .tfc-bot{font-size:9px;}
    .wallet-table-card thead.thead-premium th { font-size: 11px; padding: 10px 8px; }
    .wallet-table-card tbody td { font-size: 12px; padding: 9px 8px; }
}
</style>
</head>
<body>
<!--start page wrapper -->
<div class="page-wrapper">
    <div class="page-content">
        <!--breadcrumb-->
        <div class="page-breadcrumb d-none d-sm-flex align-items-center mb-3">
            <div class="breadcrumb-title pe-3">Wallet</div>
            <div class="ps-3">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0 p-0">
                        <li class="breadcrumb-item"><a href="javascript:;"><i class="bx bx-home-alt"></i></a>
                        </li>
                        <li class="breadcrumb-item active" aria-current="page">Wallet Management</li>
                    </ol>
                </nav>
            </div>
            <div class="ms-auto">
                <div class="btn-group">
                    
                    <span class="fw-bold fs-5" style="color:var(--gold);">⭐ Fast & Secure Payment ⭐</span>
</div>
<button type="button" class="btn btn-primary split-bg-primary dropdown-toggle dropdown-toggle-split"
                        data-bs-toggle="dropdown"> <span class="visually-hidden">Toggle Dropdown</span>
                    </button>
                    <div class="dropdown-menu dropdown-menu-right dropdown-menu-lg-end"> 
                        <a class="dropdown-item" href="javascript:;">Action</a>
                        <a class="dropdown-item" href="javascript:;">Another action</a>
                        <a class="dropdown-item" href="javascript:;">Something else here</a>
                        <div class="dropdown-divider"></div> 
                        <a class="dropdown-item" href="javascript:;">Separated link</a>
                    </div>
                </div>
            </div>


        <!-- =========================================================
             HIDDEN POPUP MODAL (khuli jagah mein, render nahi hota)
             ========================================================= -->
        <div style="display:none !important;">
            <!DOCTYPE html><html><head><title>x</title>
            <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
            <style>
            .open-btn{padding:12px 22px;border:none;background:#0ea5e9;color:#fff;border-radius:10px;cursor:pointer;font-weight:700;}
            .modal{display:none;position:fixed;z-index:99999;inset:0;background:rgba(0,0,0,0.65);}
            .modal-content{background:#fff;width:90%;max-width:520px;margin:5% auto;padding:20px;border-radius:16px;position:relative;max-height:85vh;overflow-y:auto;}
            .close-btn{position:absolute;top:12px;right:15px;font-size:28px;cursor:pointer;color:#333;}
            .info-box-title{font-size:16px;font-weight:800;margin-bottom:10px;display:flex;align-items:center;gap:8px;}
            .info-list{list-style:none;padding:0;margin:0 0 20px 0;}
            .info-list li{padding:6px 0;font-weight:600;font-size:13px;display:flex;align-items:center;gap:8px;}
            </style></head><body>
            <button class="open-btn" onclick="openInfoPopup()">How to Add Money</button>
            <div id="infoPopup" class="modal">
                <div class="modal-content">
                    <span class="close-btn" onclick="closeInfoPopup()">&times;</span>
                    <div class="info-box">
                        <div class="info-box-title"><i class="fas fa-info-circle"></i>How to Add Money?</div>
                        <ul class="info-list">
                            <li><i class="fas fa-check" style="color:#10b981;"></i> Amount daalo ya quick button dabao</li>
                            <li><i class="fas fa-check" style="color:#10b981;"></i> "Proceed to Payment" button dabao</li>
                            <li><i class="fas fa-check" style="color:#10b981;"></i> UPI / Card / NetBanking se pay karo</li>
                            <li><i class="fas fa-check" style="color:#10b981;"></i> Paisa wallet mein instant aa jayega</li>
                        </ul>
                    </div>
                    <div style="background:linear-gradient(135deg,#e0f2fe,#bae6fd);border:2px solid #0ea5e9;border-radius:12px;padding:18px;margin-bottom:20px;">
                        <div class="info-box-title" style="color:#075985;"><i class="fas fa-shield-check"></i> Security Features</div>
                        <ul class="info-list">
                            <li><i class="fas fa-lock"></i> 256-bit SSL Encryption</li>
                            <li><i class="fas fa-check-circle"></i> RBI Approved Gateway</li>
                            <li><i class="fas fa-bolt"></i> Instant Credit</li>
                            <li><i class="fas fa-headset"></i> 24/7 Support</li>
                        </ul>
                    </div>
                    <div style="background:linear-gradient(135deg,#f0fdf4,#dcfce7);border:2px solid #22c55e;border-radius:12px;padding:18px;">
                        <div class="info-box-title" style="color:#166534;"><i class="fas fa-rupee-sign"></i> Transaction Limits</div>
                        <ul class="info-list">
                            <li><i class="fas fa-arrow-down"></i> Minimum: ₹120</li>
                            <li><i class="fas fa-arrow-up"></i> Maximum: ₹50,000</li>
                            <li><i class="fas fa-clock"></i> Processing: Instant</li>
                        </ul>
                    </div>
                </div>
            </div>
            <script>
            function openInfoPopup(){document.getElementById("infoPopup").style.display="block";}
            function closeInfoPopup(){document.getElementById("infoPopup").style.display="none";}
            </script>
            </body></html>
        </div>

        <!-- =========================================================
             1. ADD BALANCE HERO CARD (screenshot jaisa)
             ========================================================= -->
        <div class="ab-hero">
            <div class="abh-left">
                <div class="abh-icon">
