<?php
include('../includes/session.php');
include('../includes/config.php');
include('../template/ahkweb/header.php');
$mobileno = $udata['phone'];


function curl_get($url, $timeout = 15) {
    $ch = curl_init();
    curl_setopt($ch, CURLOPT_URL, $url);
    curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
    curl_setopt($ch, CURLOPT_CONNECTTIMEOUT, 8);
    curl_setopt($ch, CURLOPT_TIMEOUT, $timeout);
    curl_setopt($ch, CURLOPT_SSL_VERIFYPEER, false);
    $resp = curl_exec($ch);
    $err  = curl_error($ch);
    $code = curl_getinfo($ch, CURLINFO_HTTP_CODE);
    curl_close($ch);
    return ['http_code' => $code, 'response' => $resp, 'error' => $err];
}

function curl_post($url, $data, $timeout = 15) {
    $ch = curl_init();
    curl_setopt($ch, CURLOPT_URL, $url);
    curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
    curl_setopt($ch, CURLOPT_CONNECTTIMEOUT, 8);
    curl_setopt($ch, CURLOPT_TIMEOUT, $timeout);
    curl_setopt($ch, CURLOPT_SSL_VERIFYPEER, false);
    curl_setopt($ch, CURLOPT_POST, true);
    curl_setopt($ch, CURLOPT_POSTFIELDS, http_build_query($data));
    $resp = curl_exec($ch);
    $err  = curl_error($ch);
    $code = curl_getinfo($ch, CURLINFO_HTTP_CODE);
    curl_close($ch);
    return ['http_code' => $code, 'response' => $resp, 'error' => $err];
}


function wallet_txn_exists($conn, $banktxnid, $phone) {
    $sql = "SELECT COUNT(*) as cnt FROM wallet WHERE BANKTXNID = ? AND phone = ?";
    if ($stmt = mysqli_prepare($conn, $sql)) {
        mysqli_stmt_bind_param($stmt, 'ss', $banktxnid, $phone);
        mysqli_stmt_execute($stmt);
        mysqli_stmt_bind_result($stmt, $cnt);
        mysqli_stmt_fetch($stmt);
        mysqli_stmt_close($stmt);
        return ($cnt > 0);
    }
    return false;
}


// ApnaPayHere API Configuration (Dynamic Gateway Domain from Central Manager)
$CENTRAL_GATEWAY_BASE_GPP = (function_exists('get_central_gateway_domain') ? rtrim(get_central_gateway_domain(), '/') : 'https://gateway.pdfgods.in');
$apnapayhere_url = $CENTRAL_GATEWAY_BASE_GPP . '/api';
$apnapayhere_token = "2ca474ae14e1af4ecd54c55eca01a1f1";

if ($_SERVER['REQUEST_METHOD'] === 'POST' && isset($_POST['amount'])) {
    $amount = $_POST['amount'] ?? '';

    if (!$amount || !is_numeric($amount) || $amount <= 119) {
        echo "<script>
            Swal.fire({
                icon: 'error',
                title: 'Error',
                text: 'Please enter a valid amount greater than Minimum add - 120 Rs',
                confirmButtonColor: '#4e54c8'
            });
        </script>";
    } else {
        $order_id = 'WLT_' . $mobileno . '_' . time();
        $redirect_url = 'http' . (isset($_SERVER['HTTPS']) && $_SERVER['HTTPS'] === 'on' ? 's' : '') . '://' . $_SERVER['HTTP_HOST'] . '/admin/wallet.php?verify_payment=1';
        
        $payload = [
            'customer_mobile' => $mobileno,
            'user_token' => $apnapayhere_token,
            'amount' => $amount,
            'order_id' => $order_id,
            'redirect_url' => $redirect_url,
            'remark1' => 'Wallet Recharge',
            'remark2' => $mobileno
        ];
        
        $res = curl_post($apnapayhere_url . '/create-order', $payload, 20);
        $data = json_decode($res['response'], true);

        if (isset($data['status']) && $data['status'] === true && isset($data['result']['payment_url'])) {
            $_SESSION['order_id'] = $order_id;
            $_SESSION['order_amount'] = $amount;
            $_SESSION['order_generated_time'] = time();

            $paymentModeInitial = 'ApnaPayHere';
            $statusPending = 'pending';
            $checkPending = @mysqli_prepare($ahk_conn, "SELECT id FROM wallet WHERE txn_id = ? LIMIT 1");
            $alreadyPending = false;
            if ($checkPending) {
                @mysqli_stmt_bind_param($checkPending, 's', $order_id);
                @mysqli_stmt_execute($checkPending);
                @mysqli_stmt_store_result($checkPending);
                if (@mysqli_stmt_num_rows($checkPending) > 0) $alreadyPending = true;
                @mysqli_stmt_close($checkPending);
            }
            if (!$alreadyPending) {
                $insPend = @mysqli_prepare($ahk_conn, "INSERT INTO wallet (txn_id, phone, amount, PAYMENTMODE, RESPMSG, status, txn_date, date) VALUES (?, ?, ?, ?, ?, ?, NOW(), ?)");
                if ($insPend) {
                    $todayStr = date('Y-m-d');
                    $remark = 'Wallet Recharge Pending';
                    $amountStr = (string)$amount;
                    @mysqli_stmt_bind_param($insPend, 'sssssss', $order_id, $mobileno, $amountStr, $paymentModeInitial, $remark, $statusPending, $todayStr);
                    @mysqli_stmt_execute($insPend);
                    @mysqli_stmt_close($insPend);
                }
            }
            
            header('Location: ' . $data['result']['payment_url']);
            exit();
        } else {
            $error_msg = $data['message'] ?? 'Invalid response from payment gateway';
            echo "<script>
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: '" . addslashes($error_msg) . "',
                    confirmButtonColor: '#4e54c8'
                });
            </script>";
        }
    }
}

if (isset($_GET['verify_payment']) && isset($_SESSION['order_id'])) {
    $order_id = $_SESSION['order_id'];
    
    // Check Order Status
    $payload = [
        'user_token' => $apnapayhere_token,
        'order_id' => $order_id
    ];
    
    $res = curl_post($apnapayhere_url . '/check-order-status', $payload, 20);
    $data = json_decode($res['response'], true);
    
    if (isset($data['status']) && $data['status'] === 'COMPLETED' && isset($data['result']['status']) && $data['result']['status'] === 'SUCCESS') {
        $result = $data['result'];
        $txnAmount = $result['amount'];
        $utr = $result['utr'];
        $datetime = $result['date'];
        $paymentModeFinal = 'ApnaPayHere';
        $statusSuccess = 'success';

        $didWalletTxn = false;
        // ==== FIX #2: UPDATE existing PENDING row (txn_id = order_id). If no row exists, INSERT. ====
        $checkRow = @mysqli_prepare($ahk_conn, "SELECT id FROM wallet WHERE txn_id = ? LIMIT 1");
        $existingRowId = 0;
        if ($checkRow) {
            @mysqli_stmt_bind_param($checkRow, 's', $order_id);
            @mysqli_stmt_execute($checkRow);
            @mysqli_stmt_bind_result($checkRow, $existingRowId);
            @mysqli_stmt_fetch($checkRow);
            @mysqli_stmt_close($checkRow);
        }
        if ($existingRowId > 0) {
            // Update the existing pending row → mark success
            $updStmt = @mysqli_prepare($ahk_conn, "UPDATE wallet SET BANKTXNID = ?, amount = ?, RESPMSG = ?, PAYMENTMODE = ?, status = ?, txn_date = ? WHERE id = ? LIMIT 1");
            if ($updStmt) {
                $txnAmtStr = (string)$txnAmount;
                $rowIdInt = (int)$existingRowId;
                @mysqli_stmt_bind_param($updStmt, 'ssssssi', $utr, $txnAmtStr, $paymentModeFinal, $paymentModeFinal, $statusSuccess, $datetime, $rowIdInt);
                if (@mysqli_stmt_execute($updStmt)) $didWalletTxn = true;
                @mysqli_stmt_close($updStmt);
            }
        }
        // Fallback (if no pending row existed for any reason): INSERT new
        if (!$didWalletTxn && !wallet_txn_exists($ahk_conn, $utr, $mobileno)) {
            $stmt = @mysqli_prepare($ahk_conn, "INSERT INTO wallet (txn_id, phone, BANKTXNID, amount, RESPMSG, PAYMENTMODE, status, txn_date) VALUES (?, ?, ?, ?, ?, ?, ?, ?)");
            if ($stmt) {
                $txnAmtStr = (string)$txnAmount;
                @mysqli_stmt_bind_param($stmt, 'ssssssss', $order_id, $mobileno, $utr, $txnAmtStr, $paymentModeFinal, $paymentModeFinal, $statusSuccess, $datetime);
                if (@mysqli_stmt_execute($stmt)) $didWalletTxn = true;
                @mysqli_stmt_close($stmt);
            }
        }

        // Credit user wallet
        if ($didWalletTxn || !wallet_txn_exists($ahk_conn, $utr, $mobileno)) {
            $stmt = @mysqli_prepare($ahk_conn, "UPDATE users SET balance = balance + ? WHERE phone=?");
            if ($stmt) {
                @mysqli_stmt_bind_param($stmt, 'ds', $txnAmount, $mobileno);
                @mysqli_stmt_execute($stmt);
                @mysqli_stmt_close($stmt);
            }
        }

        if (function_exists('gpGiveReferralBonusIfEligible')) {
            gpGiveReferralBonusIfEligible($mobileno, $ahk_conn);
        }
        
        unset($_SESSION['order_id']);
        unset($_SESSION['order_amount']);
        unset($_SESSION['order_generated_time']);
        
        echo "<script>
            Swal.fire({
                icon: 'success',
                title: 'Payment Successful',
                html: '<b>Amount:</b> $txnAmount<br><b>UTR:</b> $utr<br><b>Date:</b> $datetime',
                confirmButtonColor: '#4e54c8'
            }).then(() => { window.location.href = 'wallet.php'; });
        </script>";
        exit();
    } else {
        // FAILED / PENDING: update wallet entry to rejected / keep pending
        if (!empty($order_id)) {
            $stFail = @mysqli_prepare($ahk_conn, "UPDATE wallet SET status = 'rejected', RESPMSG = ? WHERE txn_id = ? AND status = 'pending' LIMIT 1");
            if ($stFail) {
                $reason = $data['message'] ?? 'Payment Failed / Cancelled';
                @mysqli_stmt_bind_param($stFail, 'ss', $reason, $order_id);
                @mysqli_stmt_execute($stFail);
                @mysqli_stmt_close($stFail);
            }
        }
        $errorMsg = $data['message'] ?? 'Payment verification failed';
        echo "<script>
            Swal.fire({
                icon: 'error',
                title: 'Payment Verification Failed',
                text: '" . addslashes($errorMsg) . "',
                confirmButtonColor: '#4e54c8'
            }).then(() => { window.location.href = 'wallet.php'; });
        </script>";
        exit();
    }
}


if ($_SERVER['REQUEST_METHOD'] === 'POST' && isset($_POST['check_order_status'])) {
    $order_id = $_POST['order_id'] ?? '';
    
    if (!$order_id) {
        echo json_encode(['status' => 'error', 'message' => 'Missing order ID']);
        exit;
    }
    
    $payload = [
        'user_token' => $apnapayhere_token,
        'order_id' => $order_id
    ];
    
    $res = curl_post($apnapayhere_url . '/check-order-status', $payload, 20);
    $data = json_decode($res['response'], true);
    
    if (isset($data['status']) && $data['status'] === 'COMPLETED' && isset($data['result']['status']) && $data['result']['status'] === 'SUCCESS') {
        $result = $data['result'];
        $txnAmount = $result['amount'];
        $utr = $result['utr'];
        $datetime = $result['date'];
        $paymentModeFinal = 'ApnaPayHere';
        $statusSuccess = 'success';

        $didWalletTxn = false;
        $checkRow = @mysqli_prepare($ahk_conn, "SELECT id FROM wallet WHERE txn_id = ? LIMIT 1");
        $existingRowId = 0;
        if ($checkRow) {
            @mysqli_stmt_bind_param($checkRow, 's', $order_id);
            @mysqli_stmt_execute($checkRow);
            @mysqli_stmt_bind_result($checkRow, $existingRowId);
            @mysqli_stmt_fetch($checkRow);
            @mysqli_stmt_close($checkRow);
        }
        if ($existingRowId > 0) {
            $updStmt = @mysqli_prepare($ahk_conn, "UPDATE wallet SET BANKTXNID = ?, amount = ?, RESPMSG = ?, PAYMENTMODE = ?, status = ?, txn_date = ? WHERE id = ? LIMIT 1");
            if ($updStmt) {
                $txnAmtStr = (string)$txnAmount;
                $rowIdInt = (int)$existingRowId;
                @mysqli_stmt_bind_param($updStmt, 'ssssssi', $utr, $txnAmtStr, $paymentModeFinal, $paymentModeFinal, $statusSuccess, $datetime, $rowIdInt);
                if (@mysqli_stmt_execute($updStmt)) $didWalletTxn = true;
                @mysqli_stmt_close($updStmt);
            }
        }
        if (!$didWalletTxn && !wallet_txn_exists($ahk_conn, $utr, $mobileno)) {
            $stmt = @mysqli_prepare($ahk_conn, "INSERT INTO wallet (txn_id, phone, BANKTXNID, amount, RESPMSG, PAYMENTMODE, status, txn_date) VALUES (?, ?, ?, ?, ?, ?, ?, ?)");
            if ($stmt) {
                $txnAmtStr = (string)$txnAmount;
                @mysqli_stmt_bind_param($stmt, 'ssssssss', $order_id, $mobileno, $utr, $txnAmtStr, $paymentModeFinal, $paymentModeFinal, $statusSuccess, $datetime);
                if (@mysqli_stmt_execute($stmt)) $didWalletTxn = true;
                @mysqli_stmt_close($stmt);
            }
        }

        if ($didWalletTxn || !wallet_txn_exists($ahk_conn, $utr, $mobileno)) {
            $stmt = @mysqli_prepare($ahk_conn, "UPDATE users SET balance = balance + ? WHERE phone=?");
            if ($stmt) {
                @mysqli_stmt_bind_param($stmt, 'ds', $txnAmount, $mobileno);
                @mysqli_stmt_execute($stmt);
                @mysqli_stmt_close($stmt);
            }
        }

        if (function_exists('gpGiveReferralBonusIfEligible')) {
            gpGiveReferralBonusIfEligible($mobileno, $ahk_conn);
        }
        
        unset($_SESSION['order_id']);
        unset($_SESSION['order_amount']);
        unset($_SESSION['order_generated_time']);
        
        echo json_encode([
            'status' => 'success', 
            'message' => 'Payment successful',
            'data' => [
                'amount' => $txnAmount,
                'utr' => $utr,
                'date' => $datetime
            ]
        ]);
        exit;
    }
    
    if (isset($data['status']) && $data['status'] !== 'COMPLETED') {
        echo json_encode(['status' => 'pending', 'message' => 'Waiting for payment completion...']);
        exit;
    }
    
    // FAILED: update pending wallet to rejected
    if (!empty($order_id)) {
        $stFail = @mysqli_prepare($ahk_conn, "UPDATE wallet SET status = 'rejected', RESPMSG = ? WHERE txn_id = ? AND status = 'pending' LIMIT 1");
        if ($stFail) {
            $reason = $data['message'] ?? 'Payment Failed';
            @mysqli_stmt_bind_param($stFail, 'ss', $reason, $order_id);
            @mysqli_stmt_execute($stFail);
            @mysqli_stmt_close($stFail);
        }
    }
    $errorMsg = $data['message'] ?? 'Unable to check order status';
    echo json_encode(['status' => 'error', 'message' => $errorMsg]);
    exit;
}


// Auto-redirect back to wallet after payment gateway returns
// ApnaPayHere will handle the redirect to the redirect_url specified
?>

