            <script>
              function setAmount(v){
                  document.getElementById('amount').value = v;
                  document.getElementById('amount').focus();
              }
              function validateAmt(){
                  var v = parseFloat(document.getElementById('amount').value) || 0;
                  if(v < 120){
                      document.getElementById('amtError').style.display = 'flex';
                      document.getElementById('amtError').className = 'winput-error we-err';
                      document.getElementById('amtError').innerHTML = '<i class="fas fa-circle-xmark"></i> Amount kam hai — Minimum ₹120 chahiye';
                      document.getElementById('amount').focus();
                      return false;
                  }
                  if(v > 50000){
                      document.getElementById('amtError').style.display = 'flex';
                      document.getElementById('amtError').className = 'winput-error we-err';
                      document.getElementById('amtError').innerHTML = '<i class="fas fa-circle-xmark"></i> ₹50,000 se zyada nahi ho sakta';
                      document.getElementById('amount').focus();
                      return false;
                  }
                  return true;
              }
            </script>
