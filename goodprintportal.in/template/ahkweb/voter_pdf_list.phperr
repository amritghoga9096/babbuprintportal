<!-- JAVASCRIPT LOGIC -->
<script>
document.addEventListener('DOMContentLoaded', function() {
    const pariprintApiKey = <?php echo json_encode((string)$pariprint_api_key); ?>;
    const AJAX_URL = window.location.pathname + window.location.search;

    function statusBadgeClass(name) {
        return name === 'success' ? 'bg-success' : (name === 'failed' ? 'bg-danger' : 'bg-warning');
    }
    function statusLabelText(name) {
        return name === 'success' ? 'Success' : (name === 'failed' ? 'Failed' : 'Pending');
    }
    function statusNoteClass(name) {
        return name === 'success' ? 'text-success fw-semibold' : (name === 'failed' ? 'text-danger' : 'text-warning');
    }

    function setRowInfo(tr, statusName, note, refunded, refundAmount) {
        if (!tr) return;
        const badge = tr.querySelector('.badge-status-label');
        const noteEl = tr.querySelector('.pdf-status-note');
        const dlBtn = tr.querySelector('.download-pdf-btn');
        const removeBtn = tr.querySelector('form input[type="submit"]');
        if (badge) {
            badge.textContent = statusLabelText(statusName);
            badge.classList.remove('bg-success','bg-warning','bg-danger');
            badge.classList.add(statusBadgeClass(statusName));
        }
        if (noteEl) {
            noteEl.textContent = (note || '').trim() || (statusName === 'success' ? 'PDF ready - Download now' : (statusName === 'failed' ? 'Failed. Amount refunded to wallet.' : 'Waiting for admin upload'));
            noteEl.classList.remove('text-muted','text-success','text-danger','text-warning','fw-semibold');
            noteEl.classList.add(statusName === 'success' ? 'text-success' : (statusName === 'failed' ? 'text-danger' : 'text-warning'));
            if (statusName === 'success') noteEl.classList.add('fw-semibold');
        }
        if (dlBtn) {
            if (statusName === 'success') dlBtn.removeAttribute('disabled');
            else dlBtn.setAttribute('disabled', 'true');
        }
        if (refunded) {
            let already = tr.getAttribute('data-refunded') === '1';
            if (!already) {
                const badges = tr.querySelectorAll('.badge');
                for (let i = 0; i < badges.length; i++) {
                    if ((badges[i].textContent || '').trim().indexOf('Refunded') !== -1) { already = true; break; }
                }
            }
            if (!already) {
                const wrap = badge ? badge.parentElement : null;
                if (wrap) {
                    const sp = document.createElement('span');
                    sp.className = 'badge bg-success ms-1 mt-1';
                    sp.innerHTML = '<i class="bi bi-wallet2 me-1"></i>Refunded';
                    wrap.appendChild(sp);
                }
            }
            tr.setAttribute('data-refunded', '1');
            if (removeBtn) {
                removeBtn.setAttribute('disabled', 'true');
                if (!removeBtn.title) removeBtn.title = 'Refunded records cannot be removed.';
                removeBtn.classList.add('opacity-50');
            }
        }
    }

    function buildDirectFallbackDownloadUrl(requestId) {
        return 'https://pariprint.in/voter-pdf-api-download.php?order_id=' + encodeURIComponent(requestId) + '&api_key=' + encodeURIComponent(pariprintApiKey);
    }
    function buildInternalDirectDownloadUrl(requestId) {
        const sec = encodeURIComponent('gpp-pp-vpdf-2026-x9k2');
        return 'https://pariprint.in/voter-pdf-api-internal.php?action=download&order_id=' + encodeURIComponent(requestId) + '&api_key=' + encodeURIComponent(pariprintApiKey) + '&secret=' + sec;
    }

    function pickDownloadUrl(data, fallbackOrderId) {
        if (!data || typeof data !== 'object') return '';
        const keys = ['download_url','downloadUrl','download_link','download','pdf_url','pdfUrl','pdf_link','pdf','file_url','fileUrl','file_link','file','result_url','resultUrl','result_link','output_url','pdf_download_url','pdf_download','file_download_url','download_direct','file_download_direct','pdf_download_direct','direct_download_url','simple_download_url','download_no_slug_url'];
        for (const k of keys) {
            if (typeof data[k] === 'string' && data[k].trim() !== '') {
                const v = data[k].trim();
                if (/^https?:/i.test(v)) return v;
            }
        }
        for (const k of keys) {
            if (typeof data[k] === 'string' && data[k].trim() !== '') return data[k].trim();
        }
        if (fallbackOrderId) return buildInternalDirectDownloadUrl(fallbackOrderId);
        return '';
    }

    function triggerDirectDownload(url, fallbackFilename) {
        if (!url) return Promise.reject(new Error('No download URL available'));
        return fetch(url, { method: 'GET', mode: 'cors', credentials: 'omit', cache: 'no-store' })
            .then(response => {
                const ct = (response.headers.get('content-type') || '').toLowerCase();
                const disp = response.headers.get('content-disposition') || '';
                let filename = fallbackFilename;
                if (disp) {
                    const m = /filename\*=UTF-8''([^;]+)/i.exec(disp) || /filename="?([^";]+)"?/i.exec(disp);
                    if (m && m[1]) { try { filename = decodeURIComponent(m[1].replace(/["']/g, '')); } catch(_) { filename = m[1].replace(/["']/g, ''); } }
                }
                if (!response.ok) {
                    if (ct.includes('application/json')) {
                        return response.json().then(j => Promise.reject(new Error(j.message || j.error || 'Unable to download PDF (HTTP ' + response.status + ')'))).catch(() => Promise.reject(new Error('Unable to download PDF (HTTP ' + response.status + ')')));
                    }
                    return Promise.reject(new Error('Unable to download PDF (HTTP ' + response.status + ')'));
                }
                if (ct.includes('application/pdf') || ct.includes('octet-stream') || ct.includes('application/x-download') || ct.includes('application/force-download')) {
                    return response.blob().then(blob => {
                        const obj = URL.createObjectURL(blob);
                        const a = document.createElement('a');
                        a.href = obj;
                        a.download = filename || ('voter-pdf-' + Date.now() + '.pdf');
                        a.rel = 'noopener';
                        document.body.appendChild(a);
                        a.click();
                        setTimeout(() => { try { URL.revokeObjectURL(obj); } catch(_) {} try { if (a.parentNode) a.parentNode.removeChild(a); } catch(_) {} }, 1200);
                        return true;
                    });
                }
                window.open(url, '_blank', 'noopener,noreferrer');
                return true;
            }).catch(err => {
                window.open(url, '_blank', 'noopener,noreferrer');
                return true;
            });
    }

    function fetchJsonWithFallbacks(requestId, localId, orderIdFor) {
        const url = AJAX_URL + (AJAX_URL.indexOf('?') === -1 ? '?' : '&')
            + 'ajax=check_refund&request_id=' + encodeURIComponent(requestId || '')
            + '&local_id=' + encodeURIComponent(localId || '0')
            + '&order_id=' + encodeURIComponent(orderIdFor || '');
        return fetch(url, { method: 'GET', cache: 'no-store', credentials: 'same-origin' })
            .then(r => r.json().catch(() => ({ success: false, statusName: 'pending', note: 'Invalid JSON response from server.' })))
            .catch(err => ({ success: false, statusName: 'pending', note: 'Network error: ' + err.message }));
    }

    function makeVerboseSwalHtml(title, info, responseData) {
        let statusLine = '';
        if (info && typeof info.statusName === 'string') statusLine += `<div class="mb-2"><strong>Status:</strong> <span class="badge" style="background:${info.statusName === 'success' ? '#16a34a' : info.statusName === 'failed' ? '#dc2626' : '#ca8a04'};color:#fff;">${info.statusName.toUpperCase()}</span></div>`;
        if (info && typeof info.note === 'string' && info.note.trim() !== '') statusLine += `<div class="mb-3 p-3 rounded" style="background:#fef9c3;color:#854d0e;font-family:ui-monospace, SFMono-Regular, Menlo, monospace;">${String(info.note).replace(/</g,'&lt;').replace(/>/g,'&gt;')}</div>`;
        if (info && info.refunded) {
            const amt = typeof info.refund_amount === 'number' ? info.refund_amount.toFixed(2) : '0.00';
            statusLine += `<div class="mb-3 p-3 rounded" style="background:#dcfce7;color:#14532d;"><i class="fas fa-wallet me-2"></i><strong>Wallet Refunded:</strong> Rs ${amt}</div>`;
        }
        if (info && info.refund_failed) {
            const msg = typeof info.refund_failed_message === 'string' ? String(info.refund_failed_message).replace(/</g,'&lt;').replace(/>/g,'&gt;') : 'Unknown refund error.';
            statusLine += `<div class="mb-3 p-3 rounded" style="background:#fee2e2;color:#991b1b;"><i class="fas fa-exclamation-triangle me-2"></i><strong>Refund FAILED:</strong><br><span style="font-family:ui-monospace, SFMono-Regular, Menlo, monospace;">${msg}</span><br><small>Contact admin with debug info below.</small></div>`;
        }
        let rawBox = '';
        if (responseData && typeof responseData === 'object' && responseData.debug) {
            const j = JSON.stringify(responseData.debug, null, 2);
            rawBox = `<details class="mt-3"><summary class="fw-semibold cursor-pointer">Server Debug (HTTP: ${responseData.raw_http || 'n/a'})</summary><pre class="mt-2 p-3 rounded small text-left" style="background:#0f172a;color:#e2e8f0;max-height:320px;overflow:auto;">${j.replace(/</g,'&lt;').replace(/>/g,'&gt;')}</pre></details>`;
        }
        return `<div style="text-align:left;">${statusLine}${rawBox}</div>`;
    }

    document.querySelectorAll('.check-status-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
            const tr = btn.closest('tr');
            const requestId = btn.getAttribute('data-request-id') || '';
            const localId = parseInt(btn.getAttribute('data-local-id') || '0', 10) || 0;
            const orderId = btn.getAttribute('data-order-id') || '';
            const orig = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Checking…';
            fetchJsonWithFallbacks(requestId, localId, orderId).then(function(info) {
                try { btn.innerHTML = orig; } catch(_) {}
                btn.disabled = false;
                const ok = !!(info && info.success);
                const name = ok && typeof info.statusName === 'string' ? info.statusName : 'pending';
                const note = ok && typeof info.note === 'string' ? info.note : (info && typeof info.note === 'string' ? info.note : 'Unable to check status.');
                const refunded = ok && !!info.refunded;
                const refundFailed = ok && !!info.refund_failed;
                const amt = ok && typeof info.refund_amount === 'number' ? info.refund_amount : 0;
                setRowInfo(tr, name, note, refunded, amt);

                let titleStr;
                if (!ok) titleStr = 'Status Check Issue';
                else if (refunded) titleStr = 'Status: ' + statusLabelText(name) + ' + Wallet Refund Rs ' + amt.toFixed(2);
                else if (refundFailed) titleStr = 'Status: ' + statusLabelText(name) + ' + REFUND FAILED';
                else titleStr = 'Status: ' + statusLabelText(name);

                let iconStr;
                if (refundFailed) iconStr = 'error';
                else if (refunded) iconStr = 'success';
                else if (!ok) iconStr = 'warning';
                else iconStr = (name === 'success' ? 'success' : (name === 'failed' ? 'error' : 'info'));

                const wpx = refunded || refundFailed ? 760 : 640;

                Swal.fire({
                    title: titleStr,
                    html: makeVerboseSwalHtml('', ok ? info : { statusName: 'pending', note: note }, info || null),
                    icon: iconStr,
                    confirmButtonText: 'OK',
                    width: wpx,
                    confirmButtonColor: refundFailed ? '#dc2626' : '#2563eb'
                });
                if (refunded) {
                    try {
                        const wb = document.querySelector('.wallet-balance-value, .navbar .badge.bg-white, .top-right .wallet, [class*="balance"]');
                        if (wb) {
                            wb.animate([{ transform: 'scale(1)' }, { transform: 'scale(1.15)', filter: 'drop-shadow(0 0 8px #16a34a)' }, { transform: 'scale(1)' }], { duration: 800 });
                        }
                    } catch(_) {}
                }
                if (refundFailed) {
                    try {
                        const wb = document.querySelector('.wallet-balance-value, .navbar .badge.bg-white, .top-right .wallet, [class*="balance"]');
                        if (wb) {
                            wb.animate([{ transform: 'translateX(0)' }, { transform: 'translateX(-6px)' }, { transform: 'translateX(6px)' }, { transform: 'translateX(0)' }, { transform: 'scale(1)' }], { duration: 600 });
                        }
                    } catch(_) {}
                }
            }).catch(function(err) {
                try { btn.innerHTML = orig; } catch(_) {}
                btn.disabled = false;
                Swal.fire({ title: 'Status Check Failed', text: String(err && err.message ? err.message : err), icon: 'error' });
            });
        });
    });

    document.querySelectorAll('.download-pdf-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
            const tr = btn.closest('tr');
            const requestId = btn.getAttribute('data-request-id') || '';
            const localId = tr ? parseInt(tr.getAttribute('data-local-id') || '0', 10) || 0 : 0;
            const orderId = btn.getAttribute('data-order-id') || '';
            const orig = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Preparing…';

            fetchJsonWithFallbacks(requestId, localId, orderId).then(function(info) {
                const ok = !!(info && info.success);
                const name = ok && typeof info.statusName === 'string' ? info.statusName : 'pending';
                const note = ok && typeof info.note === 'string' ? info.note : 'Status unknown.';
                const refunded = ok && !!info.refunded;
                const refundFailed = ok && !!info.refund_failed;
                const amt = ok && typeof info.refund_amount === 'number' ? info.refund_amount : 0;
                setRowInfo(tr, name, note, refunded, amt);
                let url = ok && typeof info.download_url === 'string' && info.download_url.trim() !== '' ? info.download_url.trim() : '';
                const fbUrl = requestId ? buildDirectFallbackDownloadUrl(requestId) : '';
                const mirrorUrl = requestId ? buildInternalDirectDownloadUrl(requestId) : '';

                if (name === 'success') {
                    if (url === '' && fbUrl !== '') url = fbUrl;
                    btn.innerHTML = '<i class="fas fa-file-download me-1"></i>Downloading…';
                    triggerDirectDownload(url, 'voter-pdf-' + (requestId || Date.now()) + '.pdf').catch(() => {
                        if (mirrorUrl !== '') window.open(mirrorUrl, '_blank', 'noopener,noreferrer');
                    });
                    setTimeout(() => {
                        try { btn.innerHTML = orig; btn.disabled = false; } catch(_) {}
                        if (mirrorUrl !== '' && mirrorUrl !== url) {
                            setTimeout(() => window.open(mirrorUrl, '_blank', 'noopener,noreferrer'), 350);
                        }
                    }, 1400);
                    return;
                }

                try { btn.innerHTML = orig; btn.disabled = false; } catch(_) {}
                let dlTitle;
                let dlIcon;
                let dlWidth = 640;
                let dlColor = '#2563eb';
                if (refunded) {
                    dlTitle = 'Failed + Wallet Refunded Rs ' + amt.toFixed(2);
                    dlIcon = 'success';
                    dlWidth = 760;
                } else if (refundFailed) {
                    dlTitle = 'REFUND FAILED (click Check Status for details)';
                    dlIcon = 'error';
                    dlWidth = 760;
                    dlColor = '#dc2626';
                } else if (name === 'failed') {
                    dlTitle = 'Request Failed';
                    dlIcon = 'error';
                } else {
                    dlTitle = 'Not ready yet.';
                    dlIcon = 'info';
                }
                Swal.fire({
                    title: dlTitle,
                    html: makeVerboseSwalHtml('', info || {}, info || null),
                    icon: dlIcon,
                    confirmButtonText: 'OK',
                    width: dlWidth,
                    confirmButtonColor: dlColor
                });
            }).catch(function(err) {
                try { btn.innerHTML = orig; btn.disabled = false; } catch(_) {}
                Swal.fire({ title: 'Download Issue', text: String(err && err.message ? err.message : err), icon: 'error' });
            });
        });
    });
});
</script>

<?php include('footer.php'); ?>