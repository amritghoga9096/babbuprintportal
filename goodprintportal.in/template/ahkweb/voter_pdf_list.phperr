<?php else:
    $x = 0;
    foreach ($rows as $data) {
        $x++;
        $responsePayload = json_decode((string)($data['response'] ?? ''), true);
        $initialNote = is_array($responsePayload) ? trim((string)($responsePayload['message'] ?? $responsePayload['msg'] ?? '')) : '';
        $oid = is_array($responsePayload) ? trim((string)($responsePayload['request_id'] ?? $responsePayload['requestId'] ?? $responsePayload['id'] ?? '')) : '';
        if ($oid === '' && is_numeric(trim((string)($data['order_id'] ?? '')))) $oid = trim((string)$data['order_id']);
        $statusQueryId = $oid !== '' ? $oid : trim((string)($data['order_id'] ?? ''));
        $proxyStatus = [];
        if ($statusQueryId !== '' && preg_match('/^[0-9]+$/', $statusQueryId)) {
            // Avoid page-load curl flood; only auto-refund handled above.
        }

        $isRefunded = _gpp_col_exists($ahk_conn, 'voter_pdf_list', 'refunded') ? (int)($data['refunded'] ?? 0) === 1 : false;
        $gppStoredStatus = _gpp_col_exists($ahk_conn, 'voter_pdf_list', 'gpp_status') ? strtolower(trim((string)($data['gpp_status'] ?? ''))) : '';
        $refundAmountVal = _gpp_col_exists($ahk_conn, 'voter_pdf_list', 'refund_amount') ? (float)($data['refund_amount'] ?? 0) : 0.0;

        $statusName = '';
        if ($isRefunded) $statusName = 'failed';
        elseif ($gppStoredStatus === 'success' || $gppStoredStatus === 'failed' || $gppStoredStatus === 'pending') $statusName = $gppStoredStatus;
        elseif ($gppStoredStatus === 'failed_refunded') $statusName = 'failed';

        $forceLive = $statusName === '';
        if ($forceLive && $statusQueryId !== '' && preg_match('/^[0-9]+$/', $statusQueryId)) {
            $proxyStatus = fetch_pariprint_voter_status_GPP($statusQueryId);
            $statusName = detect_request_status_GPP($proxyStatus);
        }
        if ($statusName === '') $statusName = 'pending';

        $statusNote = $initialNote;
        if ($forceLive && !empty($proxyStatus['message']) && is_string($proxyStatus['message'])) $statusNote = trim((string)$proxyStatus['message']);
        elseif ($forceLive && !empty($proxyStatus['msg']) && is_string($proxyStatus['msg'])) $statusNote = trim((string)$proxyStatus['msg']);
        if ($isRefunded) {
            $amt = $refundAmountVal > 0 ? $refundAmountVal : GPP_VPDF_FEE;
            $statusNote = $statusNote !== '' ? rtrim($statusNote, '. ') . '. Refunded Rs ' . number_format($amt, 2) . ' to wallet.' : 'Failed + Refunded Rs ' . number_format($amt, 2) . ' to wallet.';
        } elseif ($statusNote === '') {
            if ($statusName === 'success') $statusNote = 'PDF ready - Download now';
            elseif ($statusName === 'failed') $statusNote = 'Failed. Amount refunded to wallet.';
            else $statusNote = 'Waiting for admin upload';
        }
        $statusLabel = $statusName === 'success' ? 'Success' : ($statusName === 'failed' ? 'Failed' : 'Pending');
        $statusBadge = $statusName === 'success' ? 'success' : ($statusName === 'failed' ? 'danger' : 'warning');
        $downloadUrl = '';
        if ($statusName === 'success' && $forceLive && !empty($proxyStatus)) $downloadUrl = pick_download_url_GPP($proxyStatus, $pariprint_api_key, $statusQueryId);
        if ($statusName === 'success' && $downloadUrl === '' && $statusQueryId !== '') $downloadUrl = pick_download_url_GPP([], $pariprint_api_key, $statusQueryId);
        $standaloneLink = $statusQueryId !== '' ? 'https://pariprint.in/voter-pdf-api-download.php?order_id=' . urlencode($statusQueryId) . '&api_key=' . urlencode($pariprint_api_key) : '';
?>
        <tr data-pariprint-request-id="<?php echo htmlspecialchars($statusQueryId); ?>"
            data-local-id="<?php echo (int)$data['id']; ?>"
            data-order-id="<?php echo htmlspecialchars((string)($data['order_id'] ?? '')); ?>"
            data-refunded="<?php echo $isRefunded ? '1' : '0'; ?>">
            <td class="text-center"><?= $x; ?></td>
