                <button type="button"
                        style="margin-top:2px;margin-bottom:2px;padding-top:5px;padding-bottom:5px;"
                        class="btn btn-success btn-sm download-pdf-btn"
                        data-order-id="<?php echo htmlspecialchars((string)($data['order_id'] ?? '')); ?>"
                        data-request-id="<?php echo htmlspecialchars($statusQueryId); ?>"
                        data-refunded="<?php echo $isRefunded ? '1' : '0'; ?>"
                        <?php if ($statusName !== 'success'): ?>disabled<?php endif; ?>>
                   <i class="fas fa-download"></i> Download PDF
                </button>
                <div class="small mt-1 pdf-status-note <?php echo $statusName === 'success' ? 'text-success fw-semibold' : ($statusName === 'failed' ? 'text-danger' : 'text-warning'); ?>"><?php echo htmlspecialchars($statusNote); ?></div>
                <?php if ($downloadUrl !== '' && $statusName === 'success'): ?>
                <div class="mt-2">
                    <a href="<?php echo htmlspecialchars($downloadUrl); ?>" class="small d-block fw-semibold text-primary" target="_blank" rel="noopener noreferrer">
                        <i class="fas fa-external-link-alt me-1"></i> Direct PDF Link
                    </a>
                    <?php if ($standaloneLink !== '' && $downloadUrl !== $standaloneLink): ?>
                    <a href="<?php echo htmlspecialchars($standaloneLink); ?>" class="small d-block mt-1 text-info" target="_blank" rel="noopener noreferrer">
                        <i class="fas fa-link me-1"></i> Mirror (Standalone)
                    </a>
                    <?php endif; ?>
                </div>
                <?php endif; ?>
             </td>

            <td class="text-center">
               <form action="action_voter_pdf.php" method="post" enctype="multipart/form-data" onsubmit="return confirm('Are you sure you want to remove this record?');">
                    <input name="id" type="hidden" value="<?= (int)$data['id']; ?>" />
                    <input style="margin-top:2px;margin-bottom:2px;padding-top:5px;padding-bottom:5px;"
                           class="btn btn-danger btn-sm <?php if ($isRefunded || $statusName === 'success'): ?>opacity-50<?php endif; ?>"
                           type="submit"
                           value="Remove"
                           <?php if ($isRefunded): ?>disabled title="Refunded records cannot be removed."<?php endif; ?> />
                </form>
             </td>
         </tr>
<?php }
endif; ?>
                        </tbody>
                     </table>
