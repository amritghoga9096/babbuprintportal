            <td class="text-center status-col">
                <button type="button"
                        style="margin-top:2px;margin-bottom:2px;padding-top:5px;padding-bottom:5px;"
                        class="btn btn-info btn-sm check-status-btn"
                        data-local-id="<?php echo (int)$data['id']; ?>"
                        data-order-id="<?php echo htmlspecialchars((string)($data['order_id'] ?? '')); ?>"
                        data-request-id="<?php echo htmlspecialchars($statusQueryId); ?>"
                        data-status-message="<?php echo htmlspecialchars($statusNote); ?>">
                   <i class="fas fa-sync-alt"></i> Check Status
                </button>
                <div class="small mt-1">
                    <span class="badge bg-<?php echo $statusBadge; ?> badge-status-label"><?php echo $statusLabel; ?></span>
                    <?php if ($isRefunded): ?>
                        <span class="badge bg-success ms-1 mt-1"><i class="bi bi-wallet2 me-1"></i>Refunded</span>
                    <?php endif; ?>
                </div>
            </td>

