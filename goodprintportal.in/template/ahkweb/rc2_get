if (isset($_POST['action']) && $_POST['action'] === 'generate_pdf') {
    header('Content-Type: application/json');

    $priceRow = mysqli_fetch_assoc(mysqli_query($ahk_conn, "SELECT price FROM pricing WHERE service_name='rc_vehical_fee'"));
    $fee = $priceRow['price'] ?? 0;
    $username = $udata['phone'];
    $wallet = $udata['balance'];

    if ($wallet < $fee) {
        echo json_encode(["status"=>"error", "message"=>"Low Balance", "required"=>$fee, "available"=>$wallet]);
        exit;
    }

    $rc_no = mysqli_real_escape_string($ahk_conn, strtoupper(trim($_POST['rc_no'])));
    $captcha = mysqli_real_escape_string($ahk_conn, trim($_POST['captcha']));
    $session_id = mysqli_real_escape_string($ahk_conn, trim($_POST['session_id']));
    $user_sid = mysqli_real_escape_string($ahk_conn, trim($_POST['user_sid']));
    $card_type = mysqli_real_escape_string($ahk_conn, trim($_POST['card_type']));

    if (empty($rc_no) || empty($captcha) || empty($session_id) || empty($user_sid)) {
        echo json_encode(["status"=>"error", "message"=>"Missing captcha fields"]);
        exit;
    }

    // Call API 2 - PDF Generation
    $apiUrl = "https://apiadda.in/RC_DATA/RCPDF/rc_pdf_api.php?" . http_build_query([
