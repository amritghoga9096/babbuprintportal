<script>
$(document).ready(function(){

    // ===== CAPTCHA (API 1) =====
    function loadCaptcha(){
        var btn=$('#refreshBtn');
        btn.addClass('spin');
        $('#captchaBox').html('<svg width="90" height="30"><text x="8" y="20" fill="#aaa" font-size="11">Loading...</text></svg>');
        $('#sessionId').val('');
        $('#userSid').val('');

        $.post('', {action:'load_captcha'}, function(res){
            btn.removeClass('spin');
            if(res.status==='success'){
                $('#captchaBox').html(res.svg);
                $('#sessionId').val(res.session_id||'');
                $('#userSid').val(res.user_sid||'');
            } else {
                $('#captchaBox').html('<span style="font-size:10px;color:#ef4444">Failed</span>');
                Swal.fire({title:'Captcha Error', text:res.message||'Failed to load', icon:'error', confirmButtonColor:'#ef4444'});
            }
        }).fail(function(){
            btn.removeClass('spin');
            $('#captchaBox').html('<span style="font-size:10px;color:#ef4444">Error</span>');
        });
    }
    
    loadCaptcha();
    $('#refreshBtn').on('click', loadCaptcha);

    // ===== FETCH RC DATA =====
    var fetchedData = {};
    
    $('#fetchBtn').on('click', function(){
        var rc = $('#rc_dl').val().trim().toUpperCase();
        var cap = $('#captchaInput').val().trim();
        var sid = $('#sessionId').val();
        var usid = $('#userSid').val();
        
        if(!rc){
            Swal.fire('Missing', 'Enter RC Number', 'warning');
            return;
        }
        if(!cap){
            Swal.fire('Missing', 'Enter Captcha', 'warning');
            return;
        }
        if(!sid || !usid){
            Swal.fire('Missing', 'Load captcha first', 'warning');
            return;
        }

        var btn = $('#fetchBtn');
        btn.prop('disabled', true).html('<svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" style="animation:spin 1s linear infinite"><path d="M12 2v4m0 12v4m-7.07-15.07l2.83 2.83m8.48 8.48l2.83 2.83M2 12h4m12 0h4M4.93 19.07l2.83-2.83m8.48-8.48l2.83-2.83"/></svg><span>Fetching from VAHAN...</span>');

        $.post('', {
            action: 'fetch_rc',
            rc_no: rc,
            captcha: cap,
            session_id: sid,
            user_sid: usid
        }, function(res){
            btn.prop('disabled', false).html('<svg fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" style="width:18px;height:18px"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg><span>Fetch RC Details</span>');
            loadCaptcha();
            $('#captchaInput').val('');

            if(res.Status === 'Success' && res.data){
                fetchedData = res.data;
                
                // Populate modal fields
                $('#m_rc').val(res.data.rc_number || rc);
                $('#m_owner').val(res.data.owner_name || '');
                $('#m_father').val(res.data.father_name || '');
                $('#m_chassis').val(res.data.chassis_no || '');
                $('#m_engine').val(res.data.engine_no || '');
                $('#m_regdate').val(res.data.registration_date || '');
                $('#m_fuel').val(res.data.fuel_type || '');
                $('#m_norms').val(res.data.norms_type || '');
                $('#m_class').val(res.data.vehicle_class || '');
                $('#m_maker').val(res.data.maker || '');
                $('#m_model').val(res.data.model || '');
                $('#m_color').val(res.data.color || '');
                $('#m_body').val(res.data.body_type || '');
                $('#m_seats').val(res.data.seat_capacity || '');
                $('#m_unladen').val(res.data.unladen_weight || '');
                $('#m_cc').val(res.data.cubic_capacity || '');
                $('#m_cylinders').val(res.data.no_cylinders || '');
                $('#m_wheelbase').val(res.data.wheelbase || '');
                $('#m_mfg').val(res.data.mfg_date || '');
                $('#m_fitness').val(res.data.fitness_upto || '');
                $('#m_ownership').val(res.data.ownership || '');
                $('#m_rto').val(res.data.rto_authority || '');
                $('#m_address').val(res.data.address || '');
                
                $('#rcModal').addClass('show');
            } else {
                Swal.fire({
                    title: 'Fetch Failed',
                    text: res.Message || 'RC not found or invalid captcha',
                    icon: 'error',
                    confirmButtonColor: '#ef4444'
                });
            }
        }).fail(function(xhr, status, error){
            btn.prop('disabled', false).html('<svg fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" style="width:18px;height:18px"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg><span>Fetch RC Details</span>');
            Swal.fire('Error', 'Server request failed: ' + error, 'error');
        });
    });

    // ===== MODAL CONTROLS =====
    $('#modalClose, #modalCancel').on('click', function(){
        $('#rcModal').removeClass('show');
    });
    
    $('#rcModal').on('click', function(e){
        if(e.target === this) $(this).removeClass('show');
    });

    // ===== GENERATE PDF (API 2) =====
    $('#generateBtn').on('click', function(){
        var rc = $('#rc_dl').val().trim().toUpperCase();
        var cap = $('#captchaInput').val().trim();
        var sid = $('#sessionId').val();
        var usid = $('#userSid').val();
        
        if(!rc || !cap || !sid || !usid){
            Swal.fire('Missing Info', 'Please fetch RC details first', 'warning');
            return;
        }
        
        var btn = $('#generateBtn');
        btn.prop('disabled', true).text('⏳ Generating PDF...');

        $.post('', {
            action: 'generate_pdf',
            rc_no: rc,
            captcha: cap,
            session_id: sid,
            user_sid: usid,
            card_type: $('#cardType').val()
        }, function(res){
            btn.prop('disabled', false).text('⬇ Generate PDF');
            $('#rcModal').removeClass('show');

            if(res.status === 'success' && res.pdf){
                Swal.fire({
                    title: 'Success!',
                    html: 'Charged: <b>₹' + res.charged + '</b><br>Remaining: <b>₹' + res.remaining + '</b>',
                    icon: 'success',
                    confirmButtonColor: '#10b981'
                });
                setTimeout(function(){
                    window.location.reload();
                }, 1500);
            } else {
                Swal.fire({
                    title: 'PDF Failed',
                    text: res.message || 'Unknown error',
                    icon: 'error',
                    confirmButtonColor: '#ef4444'
                });
            }
        }).fail(function(){
            btn.prop('disabled', false).text('⬇ Generate PDF');
            Swal.fire('Error', 'Server request failed', 'error');
        });
    });

    // Enter key handlers
    $('#rc_dl, #captchaInput').on('keypress', function(e){
        if(e.which === 13){
            e.preventDefault();
            $('#fetchBtn').click();
        }
    });
});
</script>

