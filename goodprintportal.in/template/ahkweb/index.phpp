<script>
function applyUpdate() {
    if (!confirm("Are you sure you want to apply the update?")) return;

    const updateUrl = "<?php echo isset($updateInfo['update_url']) ? $updateInfo['update_url'] : ''; ?>";
    const version   = "<?php echo isset($updateInfo['version']) ? $updateInfo['version'] : ''; ?>";

    if (!updateUrl || !version) {
        alert("❌ Update information not available.");
        return;
    }

    fetch('../update/update.php', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
            update_url: updateUrl,
            version: version
        })
    })
    .then(res => res.json())
    .then(data => {
        alert(data.message);
        if (data.success) location.reload();
    })
    .catch(err => {
        alert("❌ Update Failed");
        console.error(err);
    });
}
</script>







