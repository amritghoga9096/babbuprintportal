  box-shadow: 0 8px 20px rgba(0,0,0,0.12);
}
.contact-banner .banner-image img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  display: block;
}

/* responsive: hide image on small screens and center text */
@media (max-width: 768px) {
  .contact-banner {
    flex-direction: column;
    text-align: center;
    padding: 14px;
    min-height: auto;
  }
